root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{json,yml,yaml,axaml,xaml}]
indent_size = 2

[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:suggestion
# 'this.' not required
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
# var usage
csharp_style_var_when_type_is_apparent = true:suggestion

# Test method names intentionally use underscores for readability;
# terse LINQ (First/Last) over indexable collections is fine in tests;
# a ValueTask a test expects to throw before it is ever produced has nothing to await.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.CA2012.severity = none
