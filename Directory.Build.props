<Project>
  <!-- Shared build settings for every project in the Kontena solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>Kontena</Authors>
    <Product>Kontena</Product>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <!--
    The date the build workflow made this build, shown in About and Settings (KON-268). It is passed
    in rather than read from the clock here, so every project in one build carries the same date and
    a local build carries none at all — a developer build has no release date to claim.
  -->
  <ItemGroup Condition="'$(BuildDate)' != ''">
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>
</Project>
