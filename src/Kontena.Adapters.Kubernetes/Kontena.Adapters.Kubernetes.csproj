<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Kontena.Sdk\Kontena.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The upstream metrics-server manifest, embedded rather than downloaded (KON-93): a cluster
         install must not depend on reaching GitHub at that moment, and a pinned file is one a reviewer
         can read. MetricsServerInstallTests checks its checksum, so the version it claims to be is the
         version it is. -->
    <EmbeddedResource Include="Resources\metrics-server-v0.9.0.yaml" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
