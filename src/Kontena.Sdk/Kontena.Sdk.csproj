<Project Sdk="Microsoft.NET.Sdk">

  <!-- The public extension contract, MIT licensed (see LICENSE next to this file). It must keep
       standing on its own: no ProjectReference belongs here, because anything it referenced would
       become something an external adapter author has to compile against — under a licence that is
       not MIT. Kontena.Sdk.Tests fails the build if one appears (KON-190). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pseudo-terminal behind IExecSession (KON-31). MIT, like this project: the rule above is
         about what an external adapter author is forced to compile against, and an MIT package does
         not change that. It lives here rather than in Kontena.Core because a terminal is something
         adapters provide, not something the app provides to them — the CLI-driven backends cannot
         offer one without it. -->
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

</Project>
