<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kontena.Plugins.ManifestStudio.Views"
             x:Class="Kontena.Plugins.ManifestStudio.Views.WorkspaceView"
             x:CompileBindings="False">
  <!-- x:CompileBindings off: the tree, the tab strip and the editor each bind against a different
       DataContext (WorkspaceNode / OpenDocument / WorkspaceViewModel) in the same file, and typing
       every template with x:DataType buys nothing here yet — revisit once this view stops being the
       only one. -->
  <Grid ColumnDefinitions="220,4,*">
    <DockPanel Grid.Column="0">
      <Button DockPanel.Dock="Top" Content="Open folder…" Click="OnOpenFolderClick" HorizontalAlignment="Stretch" />
      <TreeView ItemsSource="{Binding Workspace.Root.Children}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" DoubleTapped="OnNodeDoubleTapped" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

    <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top">
        <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveActiveCommand}" />
        <TabStrip ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}">
          <TabStrip.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="*" IsVisible="{Binding IsDirty}" />
                <Button Content="x" Padding="4,0" Click="OnCloseTabClick" />
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
      </DockPanel>
      <views:ManifestEditorView DataContext="{Binding ActiveDocument}" Text="{Binding Text, Mode=TwoWay}" />
    </DockPanel>
  </Grid>
</UserControl>
