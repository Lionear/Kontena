<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      Ship native code alongside the IL, so the first run of a method does not wait for the JIT
      (KON-357). Startup is where that bill lands: nothing in the app is warm yet, and the whole
      window is drawn, the kubeconfigs parsed and the first backend contacted by code that has never
      run. Measured on linux-x64, five runs each, published exactly as the build workflow does:

        first pixels    1572 ms -> 1019 ms
        usable shell    3649 ms -> 2326 ms

      It costs size — 48.6 MB compressed to 62.6 MB — which is a real trade and the reason this is
      written down rather than switched on quietly. A third off every launch, forever, against 14 MB
      once per install and per full update.

      Only with a RuntimeIdentifier: ReadyToRun compiles for a target it has to be told, and a
      publish without one (the plugin projects, a local `dotnet publish`) would fail rather than
      quietly skip. Cross-publishing is not a concern here — the workflow builds each RID on its own
      operating system.
    -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- The autostart rules (which path, what to write) are implementation details, not API — but they
         are the part that fails silently, so the tests reach them here rather than by widening them. -->
    <InternalsVisibleTo Include="Kontena.App.Tests" />
    <InternalsVisibleTo Include="Kontena.App.Ui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- icon.svg is the design source for icon.png/.ico and the KontenaLogo drawing in
         Icons.axaml — nothing loads it at runtime, so keep it out of the resource blob. -->
    <AvaloniaResource Remove="Assets\icon.svg" />
    <None Include="Assets\icon.svg" />
    <!-- The release signing key is read by a service, not drawn, so it goes in the assembly manifest
         rather than the Avalonia resource blob. Same file the Build workflow verifies its signatures
         against (KON-363) — one copy, so a rotation cannot land on only one side. The logical name is
         spelled out because the derived one depends on how MSBuild treats the dots in the filename. -->
    <AvaloniaResource Remove="Assets\release-signing.pub.pem" />
    <EmbeddedResource Include="Assets\release-signing.pub.pem" LogicalName="Kontena.App.ReleaseSigningKey.pem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Exclr8.Terminal" Version="1.0.7" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kontena.Core\Kontena.Core.csproj" />
    <ProjectReference Include="..\Kontena.Core.Orchestration\Kontena.Core.Orchestration.csproj" />
    <ProjectReference Include="..\Kontena.Engines\Kontena.Engines.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Apple\Kontena.Adapters.Apple.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Docker\Kontena.Adapters.Docker.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Podman\Kontena.Adapters.Podman.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Kubernetes\Kontena.Adapters.Kubernetes.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.LocalClusters\Kontena.Adapters.LocalClusters.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.RemoteClusters\Kontena.Adapters.RemoteClusters.csproj" />
  </ItemGroup>
</Project>
