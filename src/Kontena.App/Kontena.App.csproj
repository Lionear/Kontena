<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The autostart rules (which path, what to write) are implementation details, not API — but they
         are the part that fails silently, so the tests reach them here rather than by widening them. -->
    <InternalsVisibleTo Include="Kontena.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- icon.svg is the design source for icon.png/.ico and the KontenaLogo drawing in
         Icons.axaml — nothing loads it at runtime, so keep it out of the resource blob. -->
    <AvaloniaResource Remove="Assets\icon.svg" />
    <None Include="Assets\icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Exclr8.Terminal" Version="1.0.7" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kontena.Core\Kontena.Core.csproj" />
    <ProjectReference Include="..\Kontena.Core.Orchestration\Kontena.Core.Orchestration.csproj" />
    <ProjectReference Include="..\Kontena.Engines\Kontena.Engines.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Docker\Kontena.Adapters.Docker.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Podman\Kontena.Adapters.Podman.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.Kubernetes\Kontena.Adapters.Kubernetes.csproj" />
    <ProjectReference Include="..\Kontena.Adapters.LocalClusters\Kontena.Adapters.LocalClusters.csproj" />
  </ItemGroup>
</Project>
