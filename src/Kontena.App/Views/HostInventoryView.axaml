<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Kontena.App.Views.HostInventoryView"
             x:DataType="vm:HostInventoryViewModel">

    <StackPanel Spacing="0">

        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                   Text="Which machines take part?"/>
        <TextBlock Text="Add the hosts Kubernetes goes on and give them a role. Kontena does not touch them here — that happens at the preflight, one step on."
                   FontSize="13.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" MaxWidth="620"
                   HorizontalAlignment="Left" Margin="0,4,0,20"/>

        <!-- The key itself is never ours to hold — the same line Kontena draws for a remote engine. -->
        <Border Background="{DynamicResource InfoSoft}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="13,11" MaxWidth="620"
                HorizontalAlignment="Left" Margin="0,0,0,18">
            <StackPanel Spacing="3">
                <TextBlock Text="An SSH key, not a password" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"/>
                <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                           Text="The rollout connects with a key from your agent, or one at a path you give here. Kontena stores the path, never the key."/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                    <TextBlock Text="HOSTS" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextFaint}"/>
                    <TextBlock Text="At least one controller. Three controllers give a cluster that survives one failure — with two it does not."
                               FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Empty state: says what is needed, not merely that nothing is there. -->
                <Border IsVisible="{Binding IsEmpty}" Padding="16,20"
                        Background="{DynamicResource Surface2}" CornerRadius="{StaticResource RadiusSm}">
                    <TextBlock Text="{Binding EmptyMessage}" FontSize="13" TextWrapping="Wrap"
                               MaxWidth="480" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextDim}"/>
                </Border>

                <StackPanel Spacing="0" IsVisible="{Binding !IsEmpty}">
                    <!-- No status column, deliberately: nothing has been checked yet, and an empty
                         column reads as a check that ran and found nothing. Preflight owns that. -->
                    <Grid ColumnDefinitions="*,*,132,110,*,Auto" ColumnSpacing="8" Margin="0,0,0,7">
                        <TextBlock Grid.Column="0" Text="HOST" Classes="colhead"/>
                        <TextBlock Grid.Column="1" Text="ADDRESS" Classes="colhead"/>
                        <TextBlock Grid.Column="2" Text="ROLE" Classes="colhead"/>
                        <TextBlock Grid.Column="3" Text="USER" Classes="colhead"/>
                        <TextBlock Grid.Column="4" Text="KEY" Classes="colhead"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Hosts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HostRowViewModel">
                                <Grid ColumnDefinitions="*,*,132,110,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                    <TextBox Grid.Column="0" Text="{Binding NodeName, Mode=TwoWay}"
                                             PlaceholderText="cp-1"/>
                                    <TextBox Grid.Column="1" Text="{Binding Address, Mode=TwoWay}"
                                             PlaceholderText="10.10.4.11"
                                             FontFamily="{StaticResource Mono}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Roles}"
                                              SelectedItem="{Binding Role, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBox Grid.Column="3" Text="{Binding User, Mode=TwoWay}"
                                             PlaceholderText="root"/>
                                    <TextBox Grid.Column="4" Text="{Binding KeyPath, Mode=TwoWay}"
                                             PlaceholderText="~/.ssh/id_ed25519"
                                             FontFamily="{StaticResource Mono}"/>
                                    <Button Grid.Column="5" Classes="ghost qa" Padding="9,8"
                                            ToolTip.Tip="Remove this machine"
                                            Command="{Binding RemoveCommand}">
                                        <Path Classes="icon" Width="13" Height="13"
                                              Data="{StaticResource IconClose}"
                                              Stroke="{Binding $parent[Button].Foreground}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Content="Add host" Command="{Binding AddHostCommand}"/>
                    <Button Classes="ghost" Content="Import from k0sctl.yaml" Click="OnImport"/>
                    <TextBlock Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaint}" IsVisible="{Binding !IsEmpty}"/>
                </StackPanel>

                <TextBlock Text="{Binding ImportMessage}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDim}"
                           IsVisible="{Binding ImportMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <TextBlock Text="{Binding Problem}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="560"
                           HorizontalAlignment="Left" Foreground="{DynamicResource Danger}"
                           IsVisible="{Binding HasProblem}"/>

                <!-- A warning, not a block: rehearsing a controller failure is a real reason to want this. -->
                <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoftBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="11,9" MaxWidth="560"
                        HorizontalAlignment="Left" IsVisible="{Binding HasWarning}">
                    <TextBlock Text="{Binding Warning}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarnText}"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
