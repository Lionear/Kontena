<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Kontena.App.Views.ManifestEditor">
  <ae:TextEditor x:Name="Editor" x:FieldModifier="internal"
                 Background="Transparent" Padding="14,12"
                 FontFamily="{StaticResource Mono}" FontSize="12.5"
                 Foreground="{DynamicResource Text}"
                 LineNumbersForeground="{DynamicResource TextFaint}"
                 ShowLineNumbers="True" WordWrap="False"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
</UserControl>
