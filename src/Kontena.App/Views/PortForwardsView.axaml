<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:oal="using:Kontena.Core.Orchestration"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.PortForwardsView"
             x:DataType="vm:PortForwardsViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Port forwards" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Command="{Binding ReopenAllCommand}"
                            IsVisible="{Binding HasReopenable}">Reopen all</Button>
                    <Button Classes="ghost" Command="{Binding StopAllCommand}"
                            IsVisible="{Binding HasAny}">Stop all</Button>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding IsEmpty}" Margin="0,54,0,0" Spacing="16" HorizontalAlignment="Center" MaxWidth="520">
                <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                    <Path Classes="icon" Width="34" Height="34" Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconPlug}"/>
                </Border>
                <TextBlock Text="No port forwards yet" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                <TextBlock Text="Forward a port from a service or a pod and it keeps running here — closing the dialog no longer tears it down. Pause one to hand its local port back for a while, and what is on this list is offered again the next time you open this cluster."
                           FontSize="13" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
            </StackPanel>

            <!-- A reconnect that could not get its local port back -->
            <Border IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="14,10">
                <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
            </Border>

            <Border IsVisible="{Binding HasAny}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="1.7*,0.7*,1.4*,0.9*,300">
                            <TextBlock Grid.Column="0" Text="TARGET" Classes="colhead"/>
                            <TextBlock Grid.Column="1" Text="KIND" Classes="colhead"/>
                            <TextBlock Grid.Column="2" Text="ADDRESS" Classes="colhead"/>
                            <TextBlock Grid.Column="3" Text="STATE" Classes="colhead"/>
                            <TextBlock Grid.Column="4" Text="" Classes="colhead"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Forwards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="oal:ActivePortForward">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <Grid ColumnDefinitions="1.7*,0.7*,1.4*,0.9*,300">
                                        <TextBlock Grid.Column="0" Text="{Binding TargetLabel}" FontWeight="Medium"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetKind}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Route}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <!-- Active · Dropped (it died) · Not open (remembered from last session) -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding StateDetail}">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource Success}" IsVisible="{Binding IsActive}"/>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource Warn}" IsVisible="{Binding IsDropped}"/>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource TextFaint}" IsVisible="{Binding IsRemembered}"/>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource TextFaint}" IsVisible="{Binding IsPaused}"/>
                                            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDim}" IsVisible="{Binding !IsDropped}"/>
                                            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="Medium"
                                                       Foreground="{DynamicResource Warn}" IsVisible="{Binding IsDropped}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Classes="pill" Click="OnCopyClick" Tag="{Binding Address}">Copy</Button>
                                            <Button Classes="pill" IsVisible="{Binding IsActive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PortForwardsViewModel)DataContext).OpenCommand}"
                                                    CommandParameter="{Binding}">Open</Button>
                                            <!-- Hand the port back without losing the row; Resume puts it straight back -->
                                            <Button Classes="pill" IsVisible="{Binding IsActive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PortForwardsViewModel)DataContext).PauseCommand}"
                                                    CommandParameter="{Binding}">Pause</Button>
                                            <!-- You wanted that tunnel; offer it back on the same local port -->
                                            <Button Classes="pill" IsVisible="{Binding !IsActive}"
                                                    Content="{Binding ReopenLabel}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PortForwardsViewModel)DataContext).ReconnectCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="pill"
                                                    Command="{Binding $parent[ItemsControl].((vm:PortForwardsViewModel)DataContext).StopCommand}"
                                                    CommandParameter="{Binding}">Stop</Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
