<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Kontena.App.Views.ClusterPlaceholderView"
             x:DataType="vm:ClusterPlaceholderViewModel">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="440">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource TextDim}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
