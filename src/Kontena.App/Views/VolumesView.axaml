<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.VolumesView"
             x:DataType="vm:VolumesViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,22" Spacing="14">
            <TextBlock Text="Volumes" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource TextDim}"/>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#141821" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,12" ColumnDefinitions="1.5*,.7*,1.9*,1.1*,.7*,68">
                            <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="DRIVER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="MOUNTPOINT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="USED BY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" TextAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VolumeRowViewModel">
                                <Border Classes="row" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="18,11" ColumnDefinitions="1.5*,.7*,1.9*,1.1*,.7*,68" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource Mono}"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Driver}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Mountpoint}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{StaticResource TextFaint}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UsedByText}" FontSize="12.5"
                                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{StaticResource TextDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
