<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.VolumesView"
             x:DataType="vm:VolumesViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,22" Spacing="14">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Volumes" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="ghost" Margin="0,0,8,0" Command="{Binding ArmPruneCommand}" IsEnabled="{Binding HasDangling}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconBroom}"/>
                        <TextBlock Text="Prune unused" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="primary" Command="{Binding CreateVolumeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconPlus}"/>
                        <TextBlock Text="New volume" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextDim}"/>

            <Border IsVisible="{Binding PruneArmed}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoftBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Stroke="{DynamicResource Warn}"
                          Data="{StaticResource IconBroom}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PruneSummary}" Margin="12,0,0,0"
                               Foreground="{DynamicResource WarnText}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="ghost" Command="{Binding CancelPruneCommand}" Margin="0,0,8,0">Cancel</Button>
                    <Button Grid.Column="3" Command="{Binding PruneCommand}"
                            Background="{DynamicResource DangerSoft}" Foreground="{DynamicResource Danger}"
                            BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontWeight="SemiBold">
                        Remove volumes
                    </Button>
                </Grid>
            </Border>

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,12" ColumnDefinitions="1.5*,.7*,1.9*,1.1*,.7*,68">
                            <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="DRIVER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="MOUNTPOINT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="USED BY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" TextAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VolumeRowViewModel">
                                <Border Classes="row" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="{DynamicResource RowMargin}" ColumnDefinitions="1.5*,.7*,1.9*,1.1*,.7*,68" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource Mono}"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Driver}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Mountpoint}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{DynamicResource TextFaint}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UsedByText}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
