<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterWorkloadDetailView"
             x:DataType="vm:ClusterWorkloadDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <Button Classes="qa" Width="34" Height="34" Command="{Binding BackCommand}" ToolTip.Tip="Back to workloads">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconArrowLeft}"/>
                        </Button>
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        </Border>
                        <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="{Binding RolloutBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RolloutText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="pill" Command="{Binding ScaleCommand}" IsVisible="{Binding CanScale}">Scale</Button>
                        <Button Classes="pill" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}">Restart</Button>
                    </StackPanel>
                </Grid>

                <!-- Meta strip. The replica breakdown is the reason this page exists: one "3/3" cannot
                     say that three are ready but only two carry the current revision. -->
                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding ShowReplicas}">
                        <TextBlock Text="DESIRED" Classes="colhead"/>
                        <TextBlock Text="{Binding DesiredText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding ShowReplicas}">
                        <TextBlock Text="READY" Classes="colhead"/>
                        <TextBlock Text="{Binding ReadyText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding ShowReplicas}">
                        <TextBlock Text="UP TO DATE" Classes="colhead"/>
                        <TextBlock Text="{Binding UpToDateText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding ShowReplicas}">
                        <TextBlock Text="AVAILABLE" Classes="colhead"/>
                        <TextBlock Text="{Binding AvailableText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding IsCronJob}">
                        <TextBlock Text="SCHEDULE" Classes="colhead"/>
                        <TextBlock Text="{Binding ScheduleText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsPodsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="pods">
                        <TextBlock Text="{Binding PodsTabLabel}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">

            <!-- Overview -->
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="12">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="IMAGES" Classes="colhead"/>
                                <TextBlock Text="{Binding ImagesText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Text="LABELS" Classes="colhead"/>
                                <TextBlock Text="{Binding LabelsText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Text="SELECTOR" Classes="colhead"/>
                                <TextBlock Text="{Binding SelectorText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="3" IsVisible="{Binding !IsCronJob}">
                                <TextBlock Text="STRATEGY" Classes="colhead"/>
                                <TextBlock Text="{Binding StrategyText}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Pods -->
            <views:RelatedPodsView IsVisible="{Binding IsPodsSelected}"/>

            <!-- Events -->
            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>

            <!-- YAML -->
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
