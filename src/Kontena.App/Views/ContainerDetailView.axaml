<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:behaviors="using:Kontena.App.Behaviors"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:models="using:Kontena.Sdk.Models"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.ContainerDetailView"
             x:DataType="vm:ContainerDetailViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="0">

                <!-- Title, then the actions on their own line. One row of both is what the page had,
                     and at the drawer's width (KON-309) five buttons and a name cannot share it: the
                     buttons ran off the right edge, and squeezing them left the name as "api…". -->
                <StackPanel Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <controls:BackendChip Chip="{Binding BackendChip}" ChipSize="17"/>
                            <TextBlock Text="{Binding Backend}" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="20" Padding="10,4" VerticalAlignment="Center"
                                IsVisible="{Binding IsManaged}" ToolTip.Tip="Carries a kontena.managed label — excluded from Kontena's prune">
                            <TextBlock Text="{Binding ManagedByText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Wrapping rather than trimming: an action you cannot reach is worse than a
                         second row of buttons. -->
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Classes="ghost" Padding="12,8" Command="{Binding RestartCommand}" IsVisible="{Binding IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconRestart}"/>
                                <TextBlock Text="Restart" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Padding="12,8" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconStop}"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Padding="12,8" Command="{Binding StartCommand}" IsVisible="{Binding IsNotRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource Success}" Data="{StaticResource IconPlay}"/>
                                <TextBlock Text="Start" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Padding="12,8" Command="{Binding ShellCommand}"
                                IsVisible="{Binding SupportsExec}" IsEnabled="{Binding IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconTerminal}"/>
                                <TextBlock Text="Terminal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Padding="12,8" Command="{Binding RemoveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource Danger}" Data="{StaticResource IconTrash}"/>
                                <TextBlock Text="Remove" Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Meta strip. Wraps, and the image trims: a digest-pinned reference is longer than
                     any width this panel will ever have. -->
                <WrapPanel ItemSpacing="28" LineSpacing="10" Margin="0,16,0,0">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconTag}"/>
                            <TextBlock Text="IMAGE" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ImageText}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                   Foreground="{DynamicResource Text}" FontWeight="SemiBold" MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImageText}"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconHash}"/>
                            <TextBlock Text="ID" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ShortId}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconNetwork}"/>
                            <TextBlock Text="PORTS" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PortsText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconClock}"/>
                            <TextBlock Text="CREATED" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CreatedText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsLogsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="logs">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconLogs}"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsStatsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="stats"
                            IsVisible="{Binding SupportsStats}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconGauge}"/>
                            <TextBlock Text="Stats" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsTerminalSelected}" Command="{Binding SelectTabCommand}" CommandParameter="terminal">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconTerminal}"/>
                            <TextBlock Text="Terminal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsInspectSelected}" Command="{Binding SelectTabCommand}" CommandParameter="inspect">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconInfo}"/>
                            <TextBlock Text="Inspect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Live stat strip -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="24,16,24,0" IsVisible="{Binding SupportsStats}">
            <Border Classes="card" Padding="14,12" Margin="0,0,12,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Path Classes="icon" Width="20" Height="20" Stroke="{DynamicResource Info}" Data="{StaticResource IconCpu}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        <TextBlock Text="{Binding CpuText}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="card" Padding="14,12" Margin="0,0,12,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Path Classes="icon" Width="20" Height="20" Stroke="{DynamicResource Accent}" Data="{StaticResource IconActivity}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Memory" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding MemUsedText}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="{Binding MemLimitText}" FontSize="12" FontFamily="{StaticResource Mono}"
                                       Foreground="{DynamicResource TextFaint}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="card" Padding="14,12" Margin="0,0,12,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Path Classes="icon" Width="20" Height="20" Stroke="{DynamicResource Success}" Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Net I/O ↓/↑" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        <TextBlock Text="{Binding NetIoText}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="card" Padding="14,12" Margin="0,0,12,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Path Classes="icon" Width="20" Height="20" Stroke="{DynamicResource Warn}" Data="{StaticResource IconDatabase}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Block I/O r/w" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        <TextBlock Text="{Binding BlockIoText}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Diagnosis (KON-150): shown on every tab, because "why is it not running" is the question
             you arrive with. Absent unless the rules recognised the case — no "unknown" state. -->
        <Border Grid.Row="2" Margin="24,16,24,0" IsVisible="{Binding HasDiagnosis}"
                Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoftBorder}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,14">
            <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Margin="0,1,12,0"
                      Stroke="{DynamicResource Warn}" Data="{StaticResource IconWarning}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{Binding DiagnosisTitle}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DiagnosisExplanation}" FontSize="12.5"
                               Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding DiagnosisEvidence}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12"
                                           Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0" IsVisible="{Binding HasDiagnosisSuggestion}">
                        <TextBlock Grid.Column="0" Text="{Binding DiagnosisSuggestion}" FontSize="12.5"
                                   Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                                IsVisible="{Binding HasDiagnosisAction}"
                                Content="{Binding DiagnosisActionLabel}"
                                Command="{Binding FollowDiagnosisCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab content -->
        <Panel Grid.Row="3" Margin="24,16,24,24">

            <!-- Logs -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsLogsSelected}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                    <Border Grid.Column="0" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}" Padding="11,0">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextFaint}"
                                  Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                            <TextBox Classes="bare" Margin="8,0,0,0" PlaceholderText="Filter log lines…"
                                     Text="{Binding LogFilter, Mode=TwoWay}"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                        </DockPanel>
                    </Border>
                    <Button Grid.Column="1" Classes="pill" Classes.on="{Binding AutoScroll}" Margin="8,0,0,0"
                            Command="{Binding ToggleFollowCommand}">Follow</Button>
                    <Button Grid.Column="2" Classes="pill" Classes.on="{Binding ShowTimestamps}" Margin="8,0,0,0"
                            Command="{Binding ToggleTimestampsCommand}">Timestamps</Button>
                    <Button Grid.Column="3" Classes="pill" Classes.on="{Binding Wrap}" Margin="8,0,0,0"
                            Command="{Binding ToggleWrapCommand}">Wrap</Button>
                    <Button Grid.Column="4" Classes="pill" Margin="8,0,0,0" Command="{Binding ClearLogsCommand}">Clear</Button>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Console}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                        ClipToBounds="True">
                    <ListBox x:Name="LogList" behaviors:AutoScroll.Enabled="True" behaviors:AutoScroll.Follow="{Binding AutoScroll, Mode=TwoWay}" ItemsSource="{Binding Lines}" Background="Transparent" Padding="14,12"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#12FFFFFF"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogLineViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{Binding Timestamp}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                               LineHeight="21" Foreground="{DynamicResource TextFaint}"
                                               IsVisible="{Binding #Root.((vm:ContainerDetailViewModel)DataContext).ShowTimestamps}"/>
                                    <TextBlock Text="{Binding Level}" FontFamily="{StaticResource Mono}" FontSize="12.5" FontWeight="Bold"
                                               LineHeight="21" Foreground="{Binding LevelBrush}" IsVisible="{Binding HasLevel}"/>
                                    <TextBlock Text="{Binding Message}" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="21"
                                               Foreground="{Binding MessageBrush}"
                                               TextWrapping="{Binding #Root.((vm:ContainerDetailViewModel)DataContext).LogWrapping}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Stats -->
            <ScrollViewer IsVisible="{Binding IsStatsSelected}">
                <StackPanel Spacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Memory" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding MemUsedText}" FontFamily="{StaticResource Mono}" FontSize="13"
                                               Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding MemLimitText}" FontFamily="{StaticResource Mono}" FontSize="13"
                                               Foreground="{DynamicResource TextFaint}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding MemPercent}" Maximum="100" Height="8" CornerRadius="4"
                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface2}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Height="8" CornerRadius="4"
                                         Foreground="{DynamicResource Info}" Background="{DynamicResource Surface2}"/>
                            <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Network I/O (rx / tx)" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                <TextBlock Text="{Binding NetIoText}" FontFamily="{StaticResource Mono}" FontSize="15"
                                           Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Block I/O (read / write)" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                <TextBlock Text="{Binding BlockIoText}" FontFamily="{StaticResource Mono}" FontSize="15"
                                           Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Terminal -->
            <Panel IsVisible="{Binding IsTerminalSelected}">
                <views:TerminalView IsVisible="{Binding CanOpenTerminal}"/>
                <StackPanel IsVisible="{Binding !CanOpenTerminal}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="12">
                    <Border Width="52" Height="52" CornerRadius="{StaticResource Radius}" Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                        <Path Classes="icon" Width="24" Height="24" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconTerminal}"/>
                    </Border>
                    <TextBlock Text="Start the container to open a shell" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                    <TextBlock Text="An interactive shell needs a running container with a compatible /bin/sh."
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" MaxWidth="380"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Panel>

            <!-- Inspect -->
            <Panel IsVisible="{Binding IsInspectSelected}">

                <!-- Loading -->
                <StackPanel IsVisible="{Binding InspectLoading}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="14">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface2}"/>
                    <TextBlock Text="Inspecting…" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer IsVisible="{Binding HasInspect}">
                    <StackPanel Spacing="14">

                        <!-- Overview -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Overview" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="STATUS" Classes="ilabel"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Inspect.Status}" Classes="ivalue"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="STARTED" Classes="ilabel"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartedText}" Classes="ivalue"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="FINISHED" Classes="ilabel" IsVisible="{Binding IsNotRunning}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FinishedText}" Classes="ivalue" IsVisible="{Binding IsNotRunning}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="EXIT CODE" Classes="ilabel" IsVisible="{Binding IsNotRunning}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Inspect.ExitCode}" Classes="ivalue" IsVisible="{Binding IsNotRunning}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="RESTART POLICY" Classes="ilabel"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RestartPolicyText}" Classes="ivalue"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="IMAGE ID" Classes="ilabel"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Inspect.ImageId}" Classes="ivalue"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Command -->
                        <Border Classes="card" IsVisible="{Binding HasCommand}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Command" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="COMMAND" Classes="ilabel"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Inspect.Command}" Classes="ivalue" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="WORKING DIR" Classes="ilabel"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Inspect.WorkingDirectory}" Classes="ivalue"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="USER" Classes="ilabel"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Inspect.User}" Classes="ivalue"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Ports -->
                        <Border Classes="card" IsVisible="{Binding HasPorts}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Ports" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <ItemsControl ItemsSource="{Binding PortItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PortItem">
                                            <Panel Margin="0,3" HorizontalAlignment="Left">
                                                <!-- Published TCP port — opens in the browser -->
                                                <Button Classes="link" Command="{Binding OpenCommand}"
                                                        IsVisible="{Binding IsOpenable}" ToolTip.Tip="{Binding Url}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{Binding Text}" Classes="ivalue"
                                                                   FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Primary}"/>
                                                        <TextBlock Text="↗" FontSize="12" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- UDP / unpublished — shown, not clickable -->
                                                <TextBlock Text="{Binding Text}" Classes="ivalue" FontFamily="{StaticResource Mono}"
                                                           Foreground="{DynamicResource TextDim}" IsVisible="{Binding !IsOpenable}"/>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Networks -->
                        <Border Classes="card" IsVisible="{Binding HasNetworks}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Networks" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <ItemsControl ItemsSource="{Binding Networks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InspectNetwork">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="ivalue" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IpAddress}" Classes="ivalue" Margin="0,0,18,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Gateway}" Classes="ihint"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Mounts -->
                        <Border Classes="card" IsVisible="{Binding HasMounts}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Mounts" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <ItemsControl ItemsSource="{Binding Mounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InspectMount">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Destination}" Classes="ivalue" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Source}" Classes="ihint" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource Surface2}" CornerRadius="5" Padding="7,2">
                                                        <TextBlock Text="{Binding Type}" FontSize="11" FontFamily="{StaticResource Mono}"
                                                                   Foreground="{DynamicResource TextDim}"/>
                                                    </Border>
                                                    <TextBlock Text="rw" FontSize="11" FontFamily="{StaticResource Mono}"
                                                               Foreground="{DynamicResource Success}" IsVisible="{Binding ReadWrite}"/>
                                                    <TextBlock Text="ro" FontSize="11" FontFamily="{StaticResource Mono}"
                                                               Foreground="{DynamicResource TextFaint}" IsVisible="{Binding !ReadWrite}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Environment -->
                        <Border Classes="card" IsVisible="{Binding HasEnvironment}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Environment" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <ItemsControl ItemsSource="{Binding EnvironmentItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KeyValueItem">
                                            <Grid ColumnDefinitions="230,*" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="ivalue"
                                                           Foreground="{DynamicResource Info}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="ivalue" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Labels -->
                        <Border Classes="card" IsVisible="{Binding HasLabels}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Labels" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <ItemsControl ItemsSource="{Binding LabelItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KeyValueItem">
                                            <Grid ColumnDefinitions="230,*" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="ivalue"
                                                           Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="ivalue" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Panel>
    </Grid>
</UserControl>
