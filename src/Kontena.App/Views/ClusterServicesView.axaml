<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterServicesView"
             x:DataType="vm:ClusterServicesViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <TextBlock Text="Services" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    IsVisible="{Binding HasItems}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="1.6*,1*,1*,1.1*,1.6*,0.7*,104">
                            <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
                            <TextBlock Grid.Column="1" Text="NAMESPACE" Classes="colhead"/>
                            <TextBlock Grid.Column="2" Text="TYPE" Classes="colhead"/>
                            <TextBlock Grid.Column="3" Text="CLUSTER IP" Classes="colhead"/>
                            <TextBlock Grid.Column="4" Text="PORTS" Classes="colhead"/>
                            <TextBlock Grid.Column="5" Text="AGE" Classes="colhead"/>
                            <TextBlock Grid.Column="6" Text="" Classes="colhead" MinWidth="96"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceRow">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <Grid ColumnDefinitions="1.6*,1*,1*,1.1*,1.6*,0.7*,104">
                                        <Button Grid.Column="0" Classes="link" HorizontalAlignment="Left" Command="{Binding OpenCommand}"
                                                IsEnabled="{Binding CanOpen}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Namespace}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ClusterIp}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <!-- Trimmed text ends at the pixel where the next column starts, so the cell has to
                                             reserve the gap; the full list is on hover (KON-199). -->
                                        <TextBlock Grid.Column="4" Text="{Binding Ports}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" ToolTip.Tip="{Binding PortsTooltip}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="6" Classes="pill" HorizontalAlignment="Right" Command="{Binding ForwardCommand}" IsVisible="{Binding CanForward}">Forward</Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Typing something with no hits leaves an empty page, which reads as a page that failed
                 to load rather than a search that found nothing (KON-164). -->
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No services match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
