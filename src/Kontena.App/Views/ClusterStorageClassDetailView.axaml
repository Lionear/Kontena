<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterStorageClassDetailView"
             x:DataType="vm:ClusterStorageClassDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <!-- Which class a claim gets when it names none — same marker as the list row. -->
                    <Border IsVisible="{Binding IsDefault}" Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}" Padding="6,1" VerticalAlignment="Center"
                            ToolTip.Tip="A claim that names no storage class gets this one">
                        <TextBlock Text="default" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextDim}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="PROVISIONER" Classes="colhead"/>
                        <TextBlock Text="{Binding Provisioner}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="RECLAIM" Classes="colhead"/>
                        <TextBlock Text="{Binding Reclaim}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="EXPAND" Classes="colhead"/>
                        <TextBlock Text="{Binding Expansion}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsPodsSelected}" IsVisible="{Binding ShowPodsTab}" Command="{Binding SelectTabCommand}" CommandParameter="pods">
                        <TextBlock Text="{Binding PodsTabLabel}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">

                    <!-- Volumes: the class's own route forward (KON-445), same count and command the
                         list row uses, so the two never disagree. -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,13">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Volumes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="link" Command="{Binding OpenVolumesCommand}" IsVisible="{Binding CanOpenVolumes}">
                                <TextBlock Text="{Binding VolumeCountLabel}"/>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding VolumeCountLabel}" IsVisible="{Binding !CanOpenVolumes}" Foreground="{DynamicResource TextDim}"/>
                        </Grid>
                    </Border>

                    <!-- The API's word is WaitForFirstConsumer; this says what that means, because the
                         word is what leaves people believing their storage is broken when it is working
                         as designed. -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,13">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Binding" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="{Binding Binding}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock Text="{Binding BindingDetail}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding NoProvisioner}" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="16,13">
                        <TextBlock Text="{Binding NoProvisionerDetail}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
