<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterNodesView"
             x:DataType="vm:ClusterNodesViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <TextBlock Text="Nodes" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <Border Height="2" Margin="0,-8,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2"/></Border>
            <!-- Never silent about not being live: a list that has quietly stopped moving looks
                 exactly like a cluster where nothing is happening, and those want opposite
                 reactions (KON-250). -->
            <Border IsVisible="{Binding LiveNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,11">
                <TextBlock Text="{Binding LiveNotice}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </Border>

            <!-- No usage backend: explain the empty gauges instead of leaving dashes unexplained -->
            <Border IsVisible="{Binding ShowMetricsNotice}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,13">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{StaticResource RadiusSm}" VerticalAlignment="Top"
                            Background="{DynamicResource Surface2}">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource Info}"
                              Data="{StaticResource IconGauge}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" Spacing="3">
                        <TextBlock Text="CPU and memory usage unavailable" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding MetricsNoticeDetail}" FontSize="12.5"
                                   Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MetricsNoticeAction}" FontSize="12.5"
                                   Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>

                        <!-- The action half of the notice (KON-93). Hidden where the backend cannot
                             write to the cluster: an install button that cannot install is the dead
                             button from KON-117. -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,7,0,0"
                                    IsVisible="{Binding CanInstallMetrics}">
                            <Button Classes="primary" Command="{Binding InstallMetricsCommand}"
                                    IsEnabled="{Binding !IsInstallingMetrics}"
                                    Content="Install metrics-server"/>
                            <TextBlock Text="{Binding MetricsInstallStatus}" FontSize="12.5" MaxWidth="420"
                                       Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeCardRow">
                        <Border Width="340" Margin="0,0,14,14" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <Button Classes="link" Padding="0" HorizontalAlignment="Left"
                                                Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <TextBlock Text="{Binding Roles}" FontSize="11.5" Foreground="{DynamicResource TextFaint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Failing conditions (DiskPressure, MemoryPressure, …); absent when healthy -->
                                <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NodeProblemChip">
                                            <Border Background="{Binding Background}" CornerRadius="20" Padding="9,3"
                                                    Margin="0,0,6,0" ToolTip.Tip="{Binding Detail}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Brush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Kubelet outside the supported skew window (KON-95); absent when in sync -->
                                <Border IsVisible="{Binding HasVersionWarning}" Background="{Binding VersionWarningBackground}"
                                        CornerRadius="20" Padding="9,3" HorizontalAlignment="Left"
                                        ToolTip.Tip="{Binding VersionWarningDetail}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="11" Height="11" VerticalAlignment="Center"
                                              Stroke="{Binding VersionWarningBrush}" Data="{StaticResource IconWarning}"/>
                                        <TextBlock Text="{Binding VersionWarning}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding VersionWarningBrush}"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="9">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="CPU" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding CpuFraction}" Height="5"
                                                     Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface2}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Memory" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding MemoryFraction}" Height="5"
                                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface2}"/>
                                    </StackPanel>
                                    <!-- Disk: only the kubelet source reports it (KON-94) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding HasDisk}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Disk" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DiskText}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding DiskFraction}" Height="5"
                                                     Foreground="{DynamicResource Info}" Background="{DynamicResource Surface2}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Pods" FontSize="10.5" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Text="{Binding PodsText}" FontSize="12.5" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextDim}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Kubelet" FontSize="10.5" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Text="{Binding Version}" FontSize="12.5" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextDim}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Node maintenance (KON-251). Hidden entirely where the backend cannot do
                                     it, rather than offered and then refused. Cordon reads Uncordon on a node
                                     that already is: one button, and the label is the state. -->
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanMaintain}">
                                    <Button Classes="pill" Command="{Binding CordonCommand}" Content="{Binding CordonLabel}"
                                            ToolTip.Tip="Stop new pods being scheduled here. Pods already running stay put."/>
                                    <Button Classes="pill" Command="{Binding DrainCommand}"
                                            ToolTip.Tip="Cordon, then move the pods off — DaemonSet pods stay, and a disruption budget may refuse">Drain</Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Typing something with no hits leaves an empty page, which reads as a page that failed
                 to load rather than a search that found nothing (KON-164). -->
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No nodes match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
