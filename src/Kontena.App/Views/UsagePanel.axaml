<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="Kontena.App.Views.UsagePanel"
             x:DataType="vm:ClusterPodDetailViewModel">

    <!-- The charts, wherever they are placed (KON-345). One control used by both the Metrics tab and
         the inline block on Overview, so the two placements cannot drift apart.
         Stacked rather than side by side: the detail also opens as a ~500px drawer (KON-307), and
         two charts sharing that width are too narrow to read a spike off. -->
    <StackPanel Spacing="14">

        <!-- Range + source -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding RangeOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UsageRangeOption">
                        <Button Classes="pill" Classes.on="{Binding IsSelected}"
                                IsEnabled="{Binding IsAvailable}"
                                Content="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:ClusterPodDetailViewModel)DataContext).SelectRangeCommand}"
                                CommandParameter="{Binding Minutes}"
                                ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ClusterPodDetailViewModel)DataContext).UsageRangeHint}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="20" Padding="10,5"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UsageSourceText}" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Says why the long ranges are greyed out, rather than leaving it to be guessed. -->
        <Border Background="{DynamicResource InfoSoft}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}" Padding="13,11">
            <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Classes="icon" Width="15" Height="15" Margin="0,1,10,0"
                      Stroke="{DynamicResource Info}" Data="{StaticResource IconInfo}" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding UsageRangeHint}" FontSize="12.5"
                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- CPU -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" Padding="18,16,18,12">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="CPU" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontFamily="{StaticResource Mono}"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                </Grid>
                <TextBlock Text="{Binding CpuSubText}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,8"/>
                <controls:UsageChart Height="130" TextElement.FontFamily="{StaticResource Mono}"
                                     Values="{Binding CpuSamples}"
                                     Unit="Millicores"
                                     RangeLabel="{Binding RangeLabel}"
                                     Stroke="{DynamicResource Primary}"
                                     AxisBrush="{DynamicResource BorderSoft}"
                                     LabelBrush="{DynamicResource TextFaint}"
                                     ReadoutBackground="{DynamicResource SurfaceRaised}"/>
            </StackPanel>
        </Border>

        <!-- Memory -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" Padding="18,16,18,12">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Memory" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <TextBlock Grid.Column="1" Text="{Binding MemText}" FontFamily="{StaticResource Mono}"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                </Grid>
                <TextBlock Text="{Binding MemSubText}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,8"/>
                <controls:UsageChart Height="130" TextElement.FontFamily="{StaticResource Mono}"
                                     Values="{Binding MemSamples}"
                                     Unit="Bytes"
                                     RangeLabel="{Binding RangeLabel}"
                                     Stroke="{DynamicResource Accent}"
                                     AxisBrush="{DynamicResource BorderSoft}"
                                     LabelBrush="{DynamicResource TextFaint}"
                                     ReadoutBackground="{DynamicResource SurfaceRaised}"/>
            </StackPanel>
        </Border>

        <!-- The first poll is 15s away; an empty frame with no explanation reads as broken. -->
        <TextBlock IsVisible="{Binding UsageIsEmpty}" Text="Waiting for the first sample…"
                   FontSize="12" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
