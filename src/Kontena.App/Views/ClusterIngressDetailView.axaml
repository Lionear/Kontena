<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterIngressDetailView"
             x:DataType="vm:ClusterIngressDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center"
                                ToolTip.Tip="Which ingress controller serves this">
                            <TextBlock Text="{Binding ClassText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Open the rule in the system browser (KON-461), the way ArgoCD does: one
                             button for a single host/path, a flyout of all of them when there are more. -->
                        <Button Classes="pill" IsVisible="{Binding HasOneLink}"
                                Command="{Binding OnlyLink.OpenCommand}"
                                ToolTip.Tip="{Binding OnlyLink.Url}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="13" Height="13" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconExternalLink}"/>
                                <TextBlock Text="Open" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="pill" IsVisible="{Binding HasManyLinks}"
                                ToolTip.Tip="Open one of this ingress's hosts in the browser">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="13" Height="13" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconExternalLink}"/>
                                <TextBlock Text="Open" VerticalAlignment="Center"/>
                                <TextBlock Text="&#x25BE;" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <ItemsControl ItemsSource="{Binding Links}" MaxWidth="460">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:IngressRuleRow">
                                                <Button Classes="link" Padding="6,5" HorizontalAlignment="Stretch"
                                                        Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Url}">
                                                    <TextBlock Text="{Binding LinkText}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                               Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Classes="pill" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}">Delete</Button>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="ADDRESS" Classes="colhead"/>
                        <TextBlock Text="{Binding AddressText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">

            <!-- Overview -->
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">

                    <!-- The rules in full. On the list they are a tooltip over a trimmed cell, which
                         is the wrong place for the one thing you open an ingress to read. -->
                    <TextBlock Text="Rules" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True" IsVisible="{Binding HasRules}">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="1.6*,1.2*,1.4*">
                                    <TextBlock Grid.Column="0" Text="HOST" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="PATH" Classes="colhead"/>
                                    <TextBlock Grid.Column="2" Text="BACKEND" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IngressRuleRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                            <Grid ColumnDefinitions="1.6*,1.2*,1.4*">
                                                <TextBlock Grid.Column="0" Text="{Binding Host}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Backend}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- An ingress that routes nothing is a real and common mistake, not an empty page. -->
                    <TextBlock Text="This ingress defines no host or path rules, so it routes nothing."
                               IsVisible="{Binding !HasRules}" Foreground="{DynamicResource TextFaint}"
                               FontSize="12.5" TextWrapping="Wrap"/>

                    <StackPanel Spacing="3" IsVisible="{Binding HasDefaultBackend}">
                        <TextBlock Text="DEFAULT BACKEND" Classes="colhead"/>
                        <TextBlock Text="{Binding DefaultBackendText}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                   Foreground="{DynamicResource TextDim}"
                                   ToolTip.Tip="Where requests go that match none of the rules above"/>
                    </StackPanel>

                    <!-- Which certificate covers which host, rather than a chip that only says some
                         host is covered — the ingress with one of its three hosts in the TLS block is
                         the case worth seeing. -->
                    <TextBlock Text="TLS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" IsVisible="{Binding HasTls}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True" IsVisible="{Binding HasTls}">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="1.2*,2*">
                                    <TextBlock Grid.Column="0" Text="SECRET" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="HOSTS" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Tls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IngressTlsRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                            <Grid ColumnDefinitions="1.2*,2*">
                                                <TextBlock Grid.Column="0" Text="{Binding Secret}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Hosts}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="No TLS is configured on this ingress." IsVisible="{Binding !HasTls}"
                               Foreground="{DynamicResource TextFaint}" FontSize="12.5"/>
                </StackPanel>
            </ScrollViewer>

            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
