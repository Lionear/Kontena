<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterPodDetailView"
             x:Name="Root"
             x:DataType="vm:ClusterPodDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Button Classes="qa" Width="34" Height="34" Command="{Binding BackCommand}" ToolTip.Tip="Back to pods">
                        <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconArrowLeft}"/>
                    </Button>
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PhaseText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ReadyText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>

                    <!-- Live metrics (metrics-server capability) -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding SupportsMetrics}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="MEM" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MemText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                    </StackPanel>
                  </StackPanel>

                  <!-- Right-side actions -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="pill" Command="{Binding PortForwardCommand}" IsVisible="{Binding CanPortForward}">Port forward</Button>
                    <ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                              MinWidth="150" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <!-- Meta strip -->
                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="NODE" Classes="colhead"/>
                        <TextBlock Text="{Binding Node}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="POD IP" Classes="colhead"/>
                        <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="RESTARTS" Classes="colhead"/>
                        <TextBlock Text="{Binding RestartsText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="QOS" Classes="colhead"/>
                        <TextBlock Text="{Binding QosText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="CONTROLLED BY" Classes="colhead"/>
                        <TextBlock Text="{Binding ControlledBy}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">Overview</Button>
                    <Button Classes="tab" Classes.on="{Binding IsLogsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="logs">Logs</Button>
                    <Button Classes="tab" Classes.on="{Binding IsShellSelected}" Command="{Binding SelectTabCommand}" CommandParameter="shell">Shell</Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">Events</Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">YAML</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Panel Grid.Row="1" Margin="24,20">

            <!-- Overview -->
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">
                    <Border IsVisible="{Binding HasDiagnostic}" Background="#F5B14C1A" BorderBrush="#F5B14C55" BorderThickness="1" CornerRadius="10" Padding="14,11">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DiagnosticText}" Foreground="{DynamicResource Text}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Containers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="1.4*,2*,1*,0.8*,1.2*">
                                    <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="IMAGE" Classes="colhead"/>
                                    <TextBlock Grid.Column="2" Text="READY" Classes="colhead"/>
                                    <TextBlock Grid.Column="3" Text="RESTARTS" Classes="colhead"/>
                                    <TextBlock Grid.Column="4" Text="STATE" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ContainerRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PodContainerRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                            <Grid ColumnDefinitions="1.4*,2*,1*,0.8*,1.2*">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Image}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ReadyText}" Foreground="{DynamicResource TextDim}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Restarts}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding State}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Logs -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsLogsSelected}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                    <Border Grid.Column="0" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8" Padding="11,0">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextFaint}"
                                  Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                            <TextBox Classes="bare" Margin="8,0,0,0" PlaceholderText="Filter log lines…"
                                     Text="{Binding LogFilter, Mode=TwoWay}" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                        </DockPanel>
                    </Border>
                    <Button Grid.Column="1" Classes="pill" Classes.on="{Binding AutoScroll}" Margin="8,0,0,0" Command="{Binding ToggleFollowCommand}">Follow</Button>
                    <Button Grid.Column="2" Classes="pill" Classes.on="{Binding ShowTimestamps}" Margin="8,0,0,0" Command="{Binding ToggleTimestampsCommand}">Timestamps</Button>
                    <Button Grid.Column="3" Classes="pill" Classes.on="{Binding Wrap}" Margin="8,0,0,0" Command="{Binding ToggleWrapCommand}">Wrap</Button>
                    <Button Grid.Column="4" Classes="pill" Margin="8,0,0,0" Command="{Binding ClearLogsCommand}">Clear</Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Console}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent" Padding="14,12"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogLineViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{Binding Timestamp}" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="21"
                                               Foreground="{DynamicResource TextFaint}"
                                               IsVisible="{Binding #Root.((vm:ClusterPodDetailViewModel)DataContext).ShowTimestamps}"/>
                                    <TextBlock Text="{Binding Level}" FontFamily="{StaticResource Mono}" FontSize="12.5" FontWeight="Bold" LineHeight="21"
                                               Foreground="{Binding LevelBrush}" IsVisible="{Binding HasLevel}"/>
                                    <TextBlock Text="{Binding Message}" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="21"
                                               Foreground="{Binding MessageBrush}"
                                               TextWrapping="{Binding #Root.((vm:ClusterPodDetailViewModel)DataContext).LogWrapping}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Shell -->
            <Panel IsVisible="{Binding IsShellSelected}">
                <views:TerminalView IsVisible="{Binding CanOpenTerminal}"/>
                <StackPanel IsVisible="{Binding !CanOpenTerminal}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                        <Path Classes="icon" Width="24" Height="24" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconTerminal}"/>
                    </Border>
                    <TextBlock Text="Shell unavailable" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                    <TextBlock Text="An interactive shell needs a running pod with exec support and a compatible /bin/sh."
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Panel>

            <!-- Events -->
            <ScrollViewer IsVisible="{Binding IsEventsSelected}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PodEventRow">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding SeverityBrush}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Source}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No events for this pod." IsVisible="{Binding !HasEvents}" Foreground="{DynamicResource TextFaint}" FontSize="12.5" Margin="2,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- YAML -->
            <Border IsVisible="{Binding IsYamlSelected}" Background="{DynamicResource Console}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <ScrollViewer Padding="16,12">
                    <SelectableTextBlock Text="{Binding YamlText}" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource TextDim}"/>
                </ScrollViewer>
            </Border>
        </Panel>
    </Grid>
</UserControl>
