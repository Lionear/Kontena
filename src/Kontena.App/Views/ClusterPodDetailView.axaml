<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:Kontena.App.Behaviors"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterPodDetailView"
             x:Name="Root"
             x:DataType="vm:ClusterPodDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <!-- Title and its facts, then the actions under them. At the drawer's width (KON-310)
                     the metrics readout and the container picker met in the middle of the name. -->
                <StackPanel Spacing="12">
                  <WrapPanel ItemSpacing="12" LineSpacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PhaseText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                    </Border>
                    <!-- The mark the pods list put on this row, carried through to the page it opens
                         (KON-415). Beside the phase pill rather than instead of it: "Running" is still
                         true of a pod whose container is in CrashLoopBackOff, and that pairing is the
                         point. Glyph, wash and the reason in words — never colour on its own. -->
                    <Border Classes="trouble" CornerRadius="20" Padding="9,3" VerticalAlignment="Center" IsVisible="{Binding HasTrouble}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon trouble" Width="13" Height="13" VerticalAlignment="Center" Data="{StaticResource IconWarning}"/>
                            <TextBlock Text="{Binding Trouble}" Classes="statuscell trouble" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ReadyText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>

                    <!-- Live metrics (metrics-server capability). The sparkline behind each number is
                         the glance; the Metrics tab is where the same samples get axes (KON-345). -->
                    <views:UsageStrip DataContext="{Binding Usage}" VerticalAlignment="Center" Margin="8,0,0,0"
                                      IsVisible="{Binding $parent[UserControl].((vm:ClusterPodDetailViewModel)DataContext).ShowUsageGraphs}"/>
                  </WrapPanel>

                  <!-- Actions -->
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="pill" Command="{Binding PortForwardCommand}" IsVisible="{Binding CanPortForward}">Port forward</Button>
                    <Button Classes="pill" Command="{Binding StopForwardCommand}" IsVisible="{Binding CanStopForward}"
                            ToolTip.Tip="{Binding ActiveForward.Address}">Stop forward</Button>
                    <!-- Last of the actions; the container picker after it is not one (KON-334). -->
                    <Button Classes="pill" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}">Delete</Button>
                    <ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                              MinWidth="150" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <!-- Meta strip. Wraps, because six facts side by side is wider than the drawer. -->
                <WrapPanel ItemSpacing="28" LineSpacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="NODE" Classes="colhead"/>
                        <TextBlock Text="{Binding Node}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="POD IP" Classes="colhead"/>
                        <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="RESTARTS" Classes="colhead"/>
                        <TextBlock Text="{Binding RestartsText}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                   Classes="restarts" Classes.often="{Binding RestartedOften}" ToolTip.Tip="{Binding RestartsTip}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="QOS" Classes="colhead"/>
                        <TextBlock Text="{Binding QosText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="CONTROLLED BY" Classes="colhead"/>
                        <Button Classes="link" Command="{Binding OpenControllerCommand}" IsVisible="{Binding CanOpenController}">
                            <TextBlock Text="{Binding ControlledBy}" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                        </Button>
                        <TextBlock Text="{Binding ControlledBy}" IsVisible="{Binding !CanOpenController}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconInfo}"/>
                            <TextBlock Text="Overview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsLogsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="logs">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconLogs}"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsShellSelected}" Command="{Binding SelectTabCommand}" CommandParameter="shell">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconTerminal}"/>
                            <TextBlock Text="Shell" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconActivity}"/>
                            <TextBlock Text="Events" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsMetricsSelected}" IsVisible="{Binding ShowUsageGraphs}"
                            Command="{Binding SelectTabCommand}" CommandParameter="metrics">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconGauge}"/>
                            <TextBlock Text="Metrics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconLayers}"/>
                            <TextBlock Text="YAML" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Panel Grid.Row="1" Margin="24,20">

            <!-- Overview -->
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">
                    <!-- Diagnosis (KON-150): only present when the rules recognised the case. There is
                         no "could not determine" state on purpose — a wrong explanation costs more
                         than a missing one. -->
                    <Border IsVisible="{Binding HasDiagnosis}" Background="{DynamicResource WarnSoft}"
                            BorderBrush="{DynamicResource WarnSoftBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Margin="0,1,12,0"
                                  Stroke="{DynamicResource Warn}" Data="{StaticResource IconWarning}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="{Binding DiagnosisTitle}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DiagnosisExplanation}" FontSize="12.5"
                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>

                                <!-- The facts it was read off, verbatim, so the conclusion can be checked
                                     instead of taken. -->
                                <ItemsControl ItemsSource="{Binding DiagnosisEvidence}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                       Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0" IsVisible="{Binding HasDiagnosisSuggestion}">
                                    <TextBlock Grid.Column="0" Text="{Binding DiagnosisSuggestion}" FontSize="12.5"
                                               Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                                            IsVisible="{Binding HasDiagnosisAction}"
                                            Content="{Binding DiagnosisActionLabel}"
                                            Command="{Binding FollowDiagnosisCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- What the pod runs, on the tab you land on (KON-390). The image was only in the
                         table below, which for a one-container pod means reading a table for one fact.
                         The labels sit beside it because they are what every Service selector in the
                         namespace matches against. -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasImages}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ImagesLabel}" Classes="colhead"/>
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding HasLabels}">
                            <TextBlock Text="LABELS" Classes="colhead"/>
                            <ItemsControl ItemsSource="{Binding Labels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="6" LineSpacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="{StaticResource RadiusSm}" Padding="7,2">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextDim}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Containers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="1.7*,1.6*,1.1*,0.5*,1.2*,1.2*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="IMAGE" Classes="colhead"/>
                                    <TextBlock Grid.Column="2" Text="READY" Classes="colhead"/>
                                    <TextBlock Grid.Column="3" Text="RESTARTS" Classes="colhead"/>
                                    <TextBlock Grid.Column="4" Text="PORTS" Classes="colhead"/>
                                    <TextBlock Grid.Column="5" Text="STATE" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ContainerRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PodContainerRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                            <Grid ColumnDefinitions="1.7*,1.6*,1.1*,0.5*,1.2*,1.2*" ColumnSpacing="8">
                                                <Grid Grid.Column="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                    <!-- An init container reads as an app container that is oddly always finished
                                                         unless it says which it is. -->
                                                    <Border Grid.Column="1" IsVisible="{Binding HasKindLabel}" Background="{DynamicResource AccentSoft}"
                                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent}"/>
                                                    </Border>
                                                </Grid>
                                                <!-- A trimmed cell has no whitespace left of its own, so the ellipsis lands against
                                                     the next column unless the cell reserves the gap itself (KON-199). -->
                                                <TextBlock Grid.Column="1" Text="{Binding Image}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" ToolTip.Tip="{Binding Image}"/>
                                                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ReadyText}" Foreground="{DynamicResource TextDim}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadyText}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="3" Text="{Binding Restarts}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PortsText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" ToolTip.Tip="{Binding PortsTooltip}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding State}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Environment variables (KON-416) — what each container actually runs with. Read
                         off the pod's own spec, so this section costs no extra call: a valueFrom names
                         where the value comes from and never holds it, which is exactly what the row
                         says instead of showing a blank. -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasEnv}">
                        <TextBlock Text="Environment variables" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <ItemsControl ItemsSource="{Binding EnvGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PodEnvGroup">
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius}" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Only on a pod that has more than one container; on the rest it
                                                 would name the pod's own container back at you. -->
                                            <TextBlock Text="{Binding Container}" Classes="colhead" IsVisible="{Binding ShowContainer}"
                                                       Margin="0,0,0,8"/>

                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PodEnvRow">
                                                        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderSoft}"
                                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <!-- The eye column is a fixed width and not Auto: it collapses on
                                                                     every row that has no secret behind it, and an Auto column that
                                                                     is 26px on one row and 0 on the next moves the value column
                                                                     with it, so nothing in the card lines up. -->
                                                                <Grid ColumnDefinitions="1.1*,1.6*,26" MinHeight="26">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0" ToolTip.Tip="{Binding Name}"/>

                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsLiteral}"
                                                                               FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip.Tip="{Binding Value}"/>
                                                                    <!-- The source, not a blank: "set to nothing" and "set from
                                                                         somewhere else" are different answers. -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding SourceText}" IsVisible="{Binding !IsLiteral}"
                                                                               FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip.Tip="{Binding SourceText}"/>

                                                                    <!-- An eye rather than a "Show"/"Hide" pill, same call the
                                                                         config cards make (KON-390): the glyph carries the state
                                                                         in the width a word cannot, and its tooltip is its
                                                                         accessible name, so it says which of the two pressing it
                                                                         does (KON-56).
                                                                         Two buttons rather than one with a bound tooltip, because
                                                                         the name has to carry the variable: this page now has an
                                                                         eye in two sections, and three buttons all announcing
                                                                         "Show the value" tell a screen reader nothing about which
                                                                         value. -->
                                                                    <Panel Grid.Column="2" IsVisible="{Binding IsSecret}">
                                                                        <Button Classes="qa" Command="{Binding Secret.ToggleCommand}"
                                                                                IsEnabled="{Binding !Secret.IsBusy}" IsVisible="{Binding !Secret.IsRevealed}"
                                                                                Width="26" Height="26" ToolTip.Tip="{Binding ShowTip}">
                                                                            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconEye}"/>
                                                                        </Button>
                                                                        <Button Classes="qa on" Command="{Binding Secret.ToggleCommand}"
                                                                                IsEnabled="{Binding !Secret.IsBusy}" IsVisible="{Binding Secret.IsRevealed}"
                                                                                Width="26" Height="26" ToolTip.Tip="{Binding HideTip}">
                                                                            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconEyeOff}"/>
                                                                        </Button>
                                                                    </Panel>
                                                                </Grid>

                                                                <!-- Everything below the line only exists for a secret, and the
                                                                     wrapper is what makes that true in layout as well: a binding
                                                                     through a null Secret resolves to unset, and unset means
                                                                     IsVisible falls back to its default of true — which gave every
                                                                     literal row an empty value block and a row half again as tall
                                                                     as its neighbour. -->
                                                                <StackPanel IsVisible="{Binding IsSecret}">
                                                                    <!-- On screen only while revealed: hiding drops the value
                                                                         rather than folding it away. -->
                                                                    <StackPanel IsVisible="{Binding Secret.IsRevealed}" Margin="0,8,0,0">
                                                                        <SelectableTextBlock Text="{Binding Secret.Value}" IsVisible="{Binding !Secret.IsBinary}"
                                                                                             FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                                             Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Secret.BinaryNotice}" IsVisible="{Binding Secret.IsBinary}"
                                                                                   FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource TextDim}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Secret.Error}" IsVisible="{Binding Secret.HasError}" Margin="0,8,0,0"
                                                                               FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Config & secrets (KON-390) — which ConfigMaps and Secrets this pod reads, and
                         how. Read off the pod's own spec, so the section costs no extra call; the keys
                         behind each row do, which is why they are asked for rather than shown. -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasConfigRows}">
                        <TextBlock Text="Config &amp; secrets" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <ItemsControl ItemsSource="{Binding ConfigRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PodConfigRow">
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius}" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <Button Grid.Column="0" Classes="qa bare" Command="{Binding ToggleCommand}"
                                                        Width="22" Height="22" Margin="-2,0,6,0" IsEnabled="{Binding !IsBusy}"
                                                        VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}"
                                                        ToolTip.Tip="Show this object's keys">
                                                    <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconChevronRight}"/>
                                                </Button>
                                                <Button Grid.Column="0" Classes="qa bare" Command="{Binding ToggleCommand}"
                                                        Width="22" Height="22" Margin="-2,0,6,0" IsEnabled="{Binding !IsBusy}"
                                                        VerticalAlignment="Center" IsVisible="{Binding IsExpanded}"
                                                        ToolTip.Tip="Hide this object's keys">
                                                    <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconChevronDown}"/>
                                                </Button>

                                                <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="7,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextDim}"/>
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,14,0" ToolTip.Tip="{Binding Name}"/>

                                                <!-- The how, not just the what: a mounted object stops the next pod
                                                     from starting, a single environment key may only surface far
                                                     later and deep inside the app. -->
                                                <TextBlock Grid.Column="3" Text="{Binding UsageText}" FontSize="12"
                                                           Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Keys}" IsVisible="{Binding HasKeys}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ConfigKeyRow">
                                                        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderSoft}"
                                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Size}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <!-- An eye rather than the "Show"/"Hide" pill the config
                                                                         page uses: this row is inside a card inside a tab, and
                                                                         the glyph carries the state in the width a word cannot.
                                                                         Its tooltip is its accessible name, so it says which of
                                                                         the two pressing it does (KON-56). -->
                                                                    <Button Grid.Column="2" Classes="qa" Classes.on="{Binding IsRevealed}"
                                                                            Command="{Binding ToggleCommand}" IsEnabled="{Binding !IsBusy}"
                                                                            IsVisible="{Binding IsSecret}" Width="26" Height="26"
                                                                            ToolTip.Tip="{Binding RevealTip}">
                                                                        <Panel>
                                                                            <Path Classes="icon" Width="14" Height="14" IsVisible="{Binding !IsRevealed}"
                                                                                  Data="{StaticResource IconEye}"/>
                                                                            <Path Classes="icon" Width="14" Height="14" IsVisible="{Binding IsRevealed}"
                                                                                  Data="{StaticResource IconEyeOff}"/>
                                                                        </Panel>
                                                                    </Button>
                                                                </Grid>

                                                                <!-- On screen only while revealed: hiding drops the value
                                                                     rather than folding it away. -->
                                                                <StackPanel IsVisible="{Binding IsRevealed}" Margin="0,8,0,0">
                                                                    <SelectableTextBlock Text="{Binding Value}" IsVisible="{Binding !IsBinary}"
                                                                                         FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                                         Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                                                    <!-- Bytes are never drawn as characters: half a TLS key
                                                                         rendered as text is noise, and it is not what the
                                                                         value is. -->
                                                                    <TextBlock Text="{Binding BinaryNotice}" IsVisible="{Binding IsBinary}"
                                                                               FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource TextDim}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="0,8,0,0"
                                                                           FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Open and holding nothing is valid, and worth saying rather than
                                                 unfolding onto a blank row. -->
                                            <TextBlock Text="This object holds no keys." IsVisible="{Binding IsEmpty}" Margin="0,10,0,0"
                                                       FontSize="12.5" Foreground="{DynamicResource TextFaint}"/>
                                            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="0,10,0,0"
                                                       FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Logs -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsLogsSelected}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                    <Border Grid.Column="0" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}" Padding="11,0">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextFaint}"
                                  Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                            <TextBox Classes="bare" Margin="8,0,0,0" PlaceholderText="Filter log lines…"
                                     Text="{Binding LogFilter, Mode=TwoWay}" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                        </DockPanel>
                    </Border>
                    <!-- Only where there was an earlier run: on a container that never restarted this
                         would open an empty console, which reads as "it logged nothing" (KON-150). -->
                    <Button Grid.Column="1" Classes="pill" Classes.on="{Binding ShowPreviousLogs}" Margin="8,0,0,0"
                            IsVisible="{Binding HasPreviousRun}" Command="{Binding TogglePreviousLogsCommand}"
                            ToolTip.Tip="Show the logs of the run that ended">Previous run</Button>
                    <Button Grid.Column="2" Classes="pill" Classes.on="{Binding AutoScroll}" Margin="8,0,0,0" Command="{Binding ToggleFollowCommand}">Follow</Button>
                    <Button Grid.Column="3" Classes="pill" Classes.on="{Binding ShowTimestamps}" Margin="8,0,0,0" Command="{Binding ToggleTimestampsCommand}">Timestamps</Button>
                    <Button Grid.Column="4" Classes="pill" Classes.on="{Binding Wrap}" Margin="8,0,0,0" Command="{Binding ToggleWrapCommand}">Wrap</Button>
                    <Button Grid.Column="5" Classes="pill" Margin="8,0,0,0" Command="{Binding ClearLogsCommand}">Clear</Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Console}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                    <ListBox x:Name="LogList" behaviors:AutoScroll.Enabled="True" behaviors:AutoScroll.Follow="{Binding AutoScroll, Mode=TwoWay}" ItemsSource="{Binding Lines}" Background="Transparent" Padding="14,12"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogLineViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{Binding Timestamp}" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="21"
                                               Foreground="{DynamicResource TextFaint}"
                                               IsVisible="{Binding #Root.((vm:ClusterPodDetailViewModel)DataContext).ShowTimestamps}"/>
                                    <TextBlock Text="{Binding Level}" FontFamily="{StaticResource Mono}" FontSize="12.5" FontWeight="Bold" LineHeight="21"
                                               Foreground="{Binding LevelBrush}" IsVisible="{Binding HasLevel}"/>
                                    <TextBlock Text="{Binding Message}" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="21"
                                               Foreground="{Binding MessageBrush}"
                                               TextWrapping="{Binding #Root.((vm:ClusterPodDetailViewModel)DataContext).LogWrapping}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Shell -->
            <Panel IsVisible="{Binding IsShellSelected}">
                <views:TerminalView IsVisible="{Binding CanOpenTerminal}"/>
                <StackPanel IsVisible="{Binding !CanOpenTerminal}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <Border Width="52" Height="52" CornerRadius="{StaticResource Radius}" Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                        <Path Classes="icon" Width="24" Height="24" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconTerminal}"/>
                    </Border>
                    <TextBlock Text="Shell unavailable" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                    <!-- Say what is actually in the way when we know. A finished init container is the
                         common case here and it is not a fault — it is what success looks like for one. -->
                    <TextBlock Text="{Binding ExecBlockedReason}" IsVisible="{Binding HasExecBlockedReason}"
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="An interactive shell needs a running pod with exec support and a compatible /bin/sh."
                               IsVisible="{Binding !HasExecBlockedReason}"
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Panel>

            <!-- Events -->
            <ScrollViewer IsVisible="{Binding IsEventsSelected}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PodEventRow">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="14,11" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding SeverityBrush}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Source}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No events for this pod." IsVisible="{Binding !HasEvents}" Foreground="{DynamicResource TextFaint}" FontSize="12.5" Margin="2,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Metrics (KON-345) — the tab placement of the usage charts -->
            <ScrollViewer IsVisible="{Binding IsMetricsSelected}">
                <views:UsagePanel DataContext="{Binding Usage}"/>
            </ScrollViewer>

            <!-- YAML — a live editor: patch the resource straight from here (KON-69) -->
            <Grid IsVisible="{Binding IsYamlSelected}" RowDefinitions="*,Auto">
                <Border Grid.Row="0" Background="{DynamicResource CodeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                    <views:ManifestEditor Text="{Binding YamlText}"/>
                </Border>
                <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding YamlStatus}" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                               IsVisible="{Binding YamlStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{Binding YamlStatusBrush}"/>
                    <Button Grid.Column="1" Classes="pill" Margin="0,0,8,0" Command="{Binding RevertYamlCommand}"
                            IsEnabled="{Binding YamlIsDirty}">Revert</Button>
                    <Button Grid.Column="2" Classes="primary" Padding="13,7" FontSize="12.5"
                            Command="{Binding ApplyYamlCommand}" IsEnabled="{Binding CanApplyYaml}">Apply</Button>
                </Grid>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
