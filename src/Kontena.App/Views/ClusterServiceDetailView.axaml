<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterServiceDetailView"
             x:DataType="vm:ClusterServiceDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="pill" Command="{Binding ForwardCommand}" IsVisible="{Binding CanForward}">Port forward</Button>
                        <Button Classes="pill" Command="{Binding StopForwardCommand}" IsVisible="{Binding CanStopForward}"
                                ToolTip.Tip="{Binding ActiveForward.Address}">Stop forward</Button>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="CLUSTER IP" Classes="colhead"/>
                        <TextBlock Text="{Binding ClusterIpText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="EXTERNAL IP" Classes="colhead"/>
                        <TextBlock Text="{Binding ExternalIpText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsPodsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="pods">
                        <TextBlock Text="{Binding PodsTabLabel}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">

            <!-- Overview -->
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="3">
                        <TextBlock Text="SELECTOR" Classes="colhead"/>
                        <TextBlock Text="{Binding SelectorText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- The full port table. The list view shows only what fits one column, and
                         targetPort is exactly the field you need when traffic arrives nowhere. -->
                    <TextBlock Text="Ports" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True" IsVisible="{Binding HasPorts}">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="1.4*,1*,1.2*,1*,1*">
                                    <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="PORT" Classes="colhead"/>
                                    <TextBlock Grid.Column="2" Text="TARGET PORT" Classes="colhead"/>
                                    <TextBlock Grid.Column="3" Text="NODE PORT" Classes="colhead"/>
                                    <TextBlock Grid.Column="4" Text="PROTOCOL" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Ports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServicePortRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                            <Grid ColumnDefinitions="1.4*,1*,1.2*,1*,1*">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Port}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TargetPort}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding NodePort}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Protocol}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="This service publishes no ports." IsVisible="{Binding !HasPorts}"
                               Foreground="{DynamicResource TextFaint}" FontSize="12.5"/>
                </StackPanel>
            </ScrollViewer>

            <views:RelatedPodsView IsVisible="{Binding IsPodsSelected}"/>
            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
