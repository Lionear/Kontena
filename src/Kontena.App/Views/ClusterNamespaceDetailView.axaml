<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterNamespaceDetailView"
             x:DataType="vm:ClusterNamespaceDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding PhaseBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Phase}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="LABELS" Classes="colhead"/>
                        <TextBlock Text="{Binding Labels}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsPodsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="pods">
                        <TextBlock Text="{Binding PodsTabLabel}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Usage over time (KON-347) -->
                    <Button Classes="tab" Classes.on="{Binding IsMetricsSelected}" IsVisible="{Binding ShowUsageGraphs}"
                            Command="{Binding SelectTabCommand}" CommandParameter="metrics">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconGauge}"/>
                            <TextBlock Text="Metrics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">

                    <!-- A namespace stuck in Terminating is nearly always a finalizer on something
                         inside it, and this is where someone is standing when they wonder why. -->
                    <Border IsVisible="{Binding IsTerminating}" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="16,13">
                        <TextBlock Text="{Binding TerminatingNote}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Contents" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True" IsVisible="{Binding !ContentsLoading}">
                        <ItemsControl ItemsSource="{Binding Contents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NamespaceContentRow">
                                    <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <!-- A zero is not a link: clicking through to an empty list is a
                                                 promise this row already answered. -->
                                            <Button Grid.Column="2" Classes="pill" Command="{Binding OpenCommand}"
                                                    IsVisible="{Binding CanOpen}">Open</Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{Binding EmptyNote}" IsVisible="{Binding IsEmptyNamespace}"
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
            </ScrollViewer>

            <views:RelatedPodsView IsVisible="{Binding IsPodsSelected}"/>
            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>
            <ScrollViewer IsVisible="{Binding IsMetricsSelected}">
                <views:UsagePanel DataContext="{Binding Usage}"/>
            </ScrollViewer>
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
