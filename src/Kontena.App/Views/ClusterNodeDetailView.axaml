<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterNodeDetailView"
             x:DataType="vm:ClusterNodeDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                IsVisible="{Binding CanMaintain}">
                        <Button Classes="pill" Command="{Binding ToggleCordonCommand}" Content="{Binding CordonLabel}"/>
                        <Button Classes="pill" Command="{Binding DrainCommand}">Drain</Button>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ROLES" Classes="colhead"/>
                        <TextBlock Text="{Binding Roles}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="KUBELET" Classes="colhead"/>
                        <TextBlock Text="{Binding KubeletVersion}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="INTERNAL IP" Classes="colhead"/>
                        <TextBlock Text="{Binding InternalIp}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="PODS" Classes="colhead"/>
                        <TextBlock Text="{Binding PodCapacity}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsPodsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="pods">
                        <TextBlock Text="{Binding PodsTabLabel}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">

                    <!-- The card can only afford the word "Cordoned", which does not tell a node
                         someone is working on from one that was forgotten. Here there is room. -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="16,13">
                        <TextBlock Text="{Binding CordonState}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    </Border>

                    <Border IsVisible="{Binding HasVersionWarning}" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="16,13">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding VersionWarning}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="{Binding VersionWarningDetail}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="28">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CPU" Classes="colhead"/>
                            <TextBlock Text="{Binding Cpu}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="MEMORY" Classes="colhead"/>
                            <TextBlock Text="{Binding Memory}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="OS IMAGE" Classes="colhead"/>
                            <TextBlock Text="{Binding OsImage}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Every condition, not only the failing ones: this is where you come to read
                         what the kubelet actually says, and a healthy MemoryPressure is sometimes
                         the fact you need stated. -->
                    <TextBlock Text="Conditions" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="1.2*,0.6*,3*">
                                    <TextBlock Grid.Column="0" Text="TYPE" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="STATE" Classes="colhead"/>
                                    <TextBlock Grid.Column="2" Text="DETAIL" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NodeConditionRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                            <Grid ColumnDefinitions="1.2*,0.6*,3*">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding State}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <views:RelatedPodsView IsVisible="{Binding IsPodsSelected}"/>
            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
