<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterPodsView"
             x:DataType="vm:ClusterPodsViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Pods" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <!-- A dropdown rather than a toggle: unlike the events "warnings only", a pod's phase
                     is not binary (KON-320). -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding PhaseFilterOptions}" SelectedItem="{Binding PhaseFilter, Mode=TwoWay}" MinWidth="130"/>
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" Margin="0,-8,0,0"/>
            <!-- Never silent about not being live: a list that has quietly stopped moving looks
                 exactly like a cluster where nothing is happening, and those want opposite
                 reactions (KON-250). -->
            <Border IsVisible="{Binding LiveNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,11">
                <TextBlock Text="{Binding LiveNotice}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    IsVisible="{Binding HasItems}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="1.8*,1.1*,0.6*,1.6*,0.8*,1.5*,0.7*,84">
                            <controls:SortableHeader Grid.Column="0" Text="NAME" Key="NAME" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="1" Text="NAMESPACE" Key="NAMESPACE" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="2" Text="READY" Key="READY" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="3" Text="STATUS" Key="STATUS" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="4" Text="RESTARTS" Key="RESTARTS" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="5" Text="NODE" Key="NODE" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="6" Text="AGE" Key="AGE" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <TextBlock Grid.Column="7" Text="" Classes="colhead"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PodRow">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <Grid ColumnDefinitions="1.8*,1.1*,0.6*,1.6*,0.8*,1.5*,0.7*,84">
                                        <Button Grid.Column="0" Classes="link" HorizontalAlignment="Left" Command="{Binding OpenCommand}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Namespace}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Ready}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <!-- A Grid rather than a horizontal StackPanel: this column now
                                             carries "Init:CrashLoopBackOff" as well as "Running", and a
                                             StackPanel hands its child unbounded width, so the text runs
                                             over the restart count instead of ellipsing. -->
                                        <Grid Grid.Column="3" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                            <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Phase}" Foreground="{DynamicResource TextDim}"
                                                       Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Phase}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{Binding Restarts}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Node}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="7" Classes="pill" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">Delete</Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Typing something with no hits leaves an empty page, which reads as a page that failed
                 to load rather than a search that found nothing (KON-164). -->
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No pods match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
