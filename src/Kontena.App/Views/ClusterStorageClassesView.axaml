<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterStorageClassesView"
             x:DataType="vm:ClusterStorageClassesViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <TextBlock Text="Storage classes" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <Border Height="2" Margin="0,-8,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2"/></Border>
            <!-- Never silent about not being live: a list that has quietly stopped moving looks
                 exactly like a cluster where nothing is happening, and those want opposite
                 reactions (KON-250). -->
            <Border IsVisible="{Binding LiveNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,11">
                <TextBlock Text="{Binding LiveNotice}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    IsVisible="{Binding HasItems}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="1.4*,1.6*,1.5*,0.8*,0.7*,0.5*">
                            <controls:SortableHeader Grid.Column="0" Text="NAME" Key="NAME" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="1" Text="PROVISIONER" Key="PROVISIONER" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <TextBlock Grid.Column="2" Text="PROVISIONS" Classes="colhead"/>
                            <controls:SortableHeader Grid.Column="3" Text="RECLAIM" Key="RECLAIM" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <TextBlock Grid.Column="4" Text="EXPAND" Classes="colhead"/>
                            <controls:SortableHeader Grid.Column="5" Text="AGE" Key="AGE" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageClassRow">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="1.4*,1.6*,1.5*,0.8*,0.7*,0.5*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <!-- Which class a claim gets when it names none. Worth a marker:
                                                     it is the class most claims on this cluster will land on. -->
                                                <Border IsVisible="{Binding IsDefault}" Background="{DynamicResource SurfaceRaised}"
                                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusSm}" Padding="6,1" VerticalAlignment="Center"
                                                        ToolTip.Tip="A claim that names no storage class gets this one">
                                                    <TextBlock Text="default" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextDim}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Provisioner}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                       Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                            <!-- The API's word is WaitForFirstConsumer; this column says what that
                                                 means, because the word is what leaves people believing their
                                                 storage is broken when it is working as designed. -->
                                            <TextBlock Grid.Column="2" Text="{Binding Binding}" Foreground="{DynamicResource TextDim}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding BindingDetail}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Reclaim}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Expansion}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding NoProvisionerDetail}" IsVisible="{Binding NoProvisioner}" Margin="0,6,0,0"
                                                   FontSize="11.5" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsEmpty}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="This cluster has no storage classes, so every volume is made by hand." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No storage classes match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
