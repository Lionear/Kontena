<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="720"
             x:Class="Kontena.App.Views.RunContainerView"
             x:DataType="vm:RunContainerViewModel"
             x:Name="DialogRoot">

    <UserControl.Styles>
        <Style Selector="TextBox.fieldinput">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
        </Style>
        <Style Selector="TextBox.fieldinput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
        </Style>
        <Style Selector="ComboBox.fieldinput">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.flabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style Selector="Button.del">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.del:pointerover /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Button.addrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
        </Style>
    </UserControl.Styles>

    <Border Width="660" MaxHeight="760" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True" BoxShadow="0 32 80 0 #99000000">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="24,20"
                  Background="Transparent">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{StaticResource PrimarySoft}">
                    <Path Classes="icon" Width="19" Height="19" Stroke="{StaticResource Primary}" Data="{StaticResource IconPlay}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Run a container" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="Configure and launch — Kontena builds the run for the active engine"
                               FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="qa" Width="32" Height="32" Command="{Binding CancelCommand}" ToolTip.Tip="Close">
                    <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource TextDim}" Data="{StaticResource IconClose}"/>
                </Button>
            </Grid>

            <Border Grid.Row="0" Height="1" Background="{StaticResource Border}" VerticalAlignment="Bottom"/>

            <!-- Body -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24,20" Spacing="18">

                    <!-- Image -->
                    <StackPanel>
                        <TextBlock Classes="flabel" Text="Image"/>
                        <TextBox Classes="fieldinput" Text="{Binding Image, Mode=TwoWay}" PlaceholderText="e.g. postgres:16"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,0">
                            <Border CornerRadius="6" Padding="9,4" Background="#34D39916" IsVisible="{Binding IsImageLocal}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Found locally" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="9,4" Background="#5AB8FF16" IsVisible="{Binding IsImagePulled}">
                                <TextBlock Text="Will be pulled before start" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Info}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Name + Restart -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="flabel" Text="Container name  (optional)"/>
                            <TextBox Classes="fieldinput" Text="{Binding ContainerName, Mode=TwoWay}" PlaceholderText="auto-generated"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="flabel" Text="Restart policy"/>
                            <ComboBox Classes="fieldinput" ItemsSource="{Binding RestartPolicies}"
                                      SelectedItem="{Binding SelectedRestartPolicy, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ports -->
                    <StackPanel>
                        <TextBlock Classes="flabel" Text="Port mappings  (host → container)"/>
                        <ItemsControl ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PortRow">
                                    <Grid ColumnDefinitions="*,22,*,Auto" Margin="0,0,0,8">
                                        <TextBox Grid.Column="0" Classes="fieldinput" Text="{Binding Host, Mode=TwoWay}" PlaceholderText="host"/>
                                        <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource Mono}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Classes="fieldinput" Text="{Binding Container, Mode=TwoWay}" PlaceholderText="container e.g. 5432/tcp"/>
                                        <Button Grid.Column="3" Classes="del" Margin="8,0,0,0"
                                                Command="{Binding #DialogRoot.((vm:RunContainerViewModel)DataContext).RemovePortCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource TextFaint}" Data="{StaticResource IconTrash}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="addrow" Command="{Binding AddPortCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Primary}" Data="{StaticResource IconPlus}"/>
                                <TextBlock Text="Add port" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Environment -->
                    <StackPanel>
                        <TextBlock Classes="flabel" Text="Environment variables"/>
                        <ItemsControl ItemsSource="{Binding EnvVars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EnvRow">
                                    <Grid ColumnDefinitions="*,22,*,Auto" Margin="0,0,0,8">
                                        <TextBox Grid.Column="0" Classes="fieldinput" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="KEY"/>
                                        <TextBlock Grid.Column="1" Text="=" Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource Mono}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Classes="fieldinput" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value"/>
                                        <Button Grid.Column="3" Classes="del" Margin="8,0,0,0"
                                                Command="{Binding #DialogRoot.((vm:RunContainerViewModel)DataContext).RemoveEnvCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource TextFaint}" Data="{StaticResource IconTrash}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="addrow" Command="{Binding AddEnvCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Primary}" Data="{StaticResource IconPlus}"/>
                                <TextBlock Text="Add variable" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Volumes -->
                    <StackPanel>
                        <TextBlock Classes="flabel" Text="Volume mounts  (source → container path)"/>
                        <ItemsControl ItemsSource="{Binding Volumes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VolumeRow">
                                    <Grid ColumnDefinitions="*,22,*,Auto" Margin="0,0,0,8">
                                        <TextBox Grid.Column="0" Classes="fieldinput" Text="{Binding Source, Mode=TwoWay}" PlaceholderText="volume or host path"/>
                                        <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource Mono}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Classes="fieldinput" Text="{Binding Destination, Mode=TwoWay}" PlaceholderText="/path/in/container"/>
                                        <Button Grid.Column="3" Classes="del" Margin="8,0,0,0"
                                                Command="{Binding #DialogRoot.((vm:RunContainerViewModel)DataContext).RemoveVolumeCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource TextFaint}" Data="{StaticResource IconTrash}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="addrow" Command="{Binding AddVolumeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Primary}" Data="{StaticResource IconPlus}"/>
                                <TextBlock Text="Add volume" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Network -->
                    <StackPanel>
                        <TextBlock Classes="flabel" Text="Network"/>
                        <ComboBox Classes="fieldinput" ItemsSource="{Binding Networks}"
                                  SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Background="#12161D">
                <Border Height="1" Background="{StaticResource Border}"/>
                <Grid ColumnDefinitions="Auto,*" Margin="24,12" MinHeight="20">
                    <TextBlock Grid.Column="0" Text="preview" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CommandPreview}" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{StaticResource Border}"/>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{StaticResource Danger}" FontSize="12.5" Margin="24,12,24,0" TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,Auto" Margin="24,16">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource DockerChip}">
                            <TextBlock Text="{Binding BackendChip}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="10"
                                       Foreground="{StaticResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center">
                            <Run Text="Running on"/><Run Text=" "/><Run Text="{Binding BackendName}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Classes="ghost" Command="{Binding CancelCommand}">Cancel</Button>
                        <Button Classes="primary" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource PrimaryInk}" Data="{StaticResource IconPlay}"/>
                                <TextBlock Text="Run container" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
