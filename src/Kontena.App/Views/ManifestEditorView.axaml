<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="Kontena.App.Views.ManifestEditorView"
             x:DataType="vm:ManifestEditorViewModel">

    <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <Border Grid.Row="0" Background="{DynamicResource CodeSurface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
            <TextBox Text="{Binding Text}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     IsReadOnly="{Binding !CanWrite}"
                     Background="Transparent" BorderThickness="0" Padding="16,12"
                     FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto">
            <!-- The cluster's own words, which is where the rejected field's name is. -->
            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12.5"
                       TextWrapping="Wrap" Margin="0,0,14,0"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{Binding StatusBrush}"/>

            <Button Grid.Column="1" Classes="pill" Margin="0,0,8,0" Command="{Binding RevertCommand}"
                    IsVisible="{Binding CanWrite}" IsEnabled="{Binding IsDirty}">Revert</Button>
            <!-- Its own button rather than an automatic step before Apply: a check that always
                 happens is a check nobody reads. -->
            <Button Grid.Column="2" Classes="pill" Margin="0,0,8,0" Command="{Binding CheckCommand}"
                    IsVisible="{Binding CanWrite}" IsEnabled="{Binding CanApply}"
                    ToolTip.Tip="Ask the cluster what this would change, without changing it">Check</Button>
            <Button Grid.Column="3" Classes="primary" Command="{Binding ApplyCommand}"
                    IsVisible="{Binding CanWrite}" IsEnabled="{Binding CanApply}">Apply</Button>
        </Grid>
    </Grid>
</UserControl>
