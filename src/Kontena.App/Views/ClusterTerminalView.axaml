<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterTerminalView"
             x:DataType="vm:ClusterTerminalViewModel">
    <Grid Margin="28,24" RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0" Text="Terminal" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}"/>

        <!-- What this shell is set up with. Said out loud because the whole point of the page is the
             environment it starts in, and an environment you cannot see is one you end up checking
             with kubectl config current-context anyway. -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,16" ItemSpacing="8" LineSpacing="8">
            <Border Background="{DynamicResource Surface2}" CornerRadius="{StaticResource RadiusSm}" Padding="9,5">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="context" FontSize="11.5" Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Context}" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Surface2}" CornerRadius="{StaticResource RadiusSm}" Padding="9,5"
                    IsVisible="{Binding HasNamespace}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="namespace" FontSize="11.5" Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Surface2}" CornerRadius="{StaticResource RadiusSm}" Padding="9,5">
                <TextBlock Text="k = kubectl" FontFamily="{StaticResource Mono}" FontSize="12"
                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
            </Border>
        </WrapPanel>

        <views:TerminalView Grid.Row="2"/>
    </Grid>
</UserControl>
