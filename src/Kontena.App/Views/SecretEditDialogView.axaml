<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Kontena.App.Views.SecretEditDialogView"
             x:DataType="vm:SecretEditDialogViewModel">

    <!-- KON-418 — design preview. The same 760x620 shell EditManifestDialogView uses, so this is
         the dialog that would replace it rather than a second kind of window. -->
    <Border Width="760" Height="620" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True" BoxShadow="0 32 80 0 #99000000">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header: the same shape the config detail page carries above its keys — name, type,
                 how many keys, how old — so opening the editor is recognisably the same object. -->
            <StackPanel Grid.Row="0" Margin="24,22,24,0" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="KEYS" Classes="colhead"/>
                        <TextBlock Text="{Binding KeyCountText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Two views of one document, not two editors. YAML stays reachable because type,
                     labels, annotations and binary data have no field here — and because a field
                     editor that base64-encodes out of sight is only safe if you can look. -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsFieldsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="fields">
                        <TextBlock Text="Fields" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Panel Grid.Row="1" Margin="24,16,24,0">

                <ScrollViewer IsVisible="{Binding IsFieldsSelected}">
                    <StackPanel Spacing="12">

                        <!-- Said rather than assumed: the manifest this is a view of holds the
                             values, so the mask is about the screen and not about the process. The
                             detail page makes the stronger promise (fetch per key, drop on hide);
                             an editor cannot, because Apply has to send every key back. -->
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextDim}" LineHeight="19"
                                   Text="Values are decoded from the live manifest and masked — press the eye on a row to read one. Type, labels and annotations are edited in the YAML view."/>

                        <ItemsControl ItemsSource="{Binding Keys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SecretFieldRow">
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius}" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel Spacing="8">

                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="KEY_NAME"
                                                         FontFamily="{StaticResource Mono}" FontSize="12.5" Margin="0,0,10,0"/>

                                                <!-- What changed, on the row that changed it, so Revert is
                                                     not the only way to find out. -->
                                                <Border Grid.Column="1" CornerRadius="20" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Background="{DynamicResource Surface2}" IsVisible="{Binding IsChanged}">
                                                    <TextBlock Text="changed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                                                </Border>
                                                <Border Grid.Column="1" CornerRadius="20" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Background="{DynamicResource Surface2}" IsVisible="{Binding IsNew}">
                                                    <TextBlock Text="new" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Size}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                           Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <Button Grid.Column="3" Classes="qa" Command="{Binding UndoCommand}" Width="26" Height="26"
                                                        Margin="0,0,6,0" IsVisible="{Binding IsChanged}"
                                                        ToolTip.Tip="Put this key back the way the cluster has it">
                                                    <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconRefresh}"/>
                                                </Button>

                                                <Button Grid.Column="4" Classes="qa danger" Command="{Binding RemoveCommand}" Width="26" Height="26"
                                                        ToolTip.Tip="{Binding RemoveTip}">
                                                    <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconTrash}"/>
                                                </Button>
                                            </Grid>

                                            <!-- The value. One box, masked, with the eye switching the
                                                 mask rather than a second control appearing: an eye is
                                                 what the config page and the pod detail already use, and
                                                 a "Show"/"Hide" pill costs width a row this dense does
                                                 not have (KON-390, KON-416). -->
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsBinary}">
                                                <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" PasswordChar="•"
                                                         RevealPassword="{Binding IsRevealed}" AcceptsReturn="False"
                                                         FontFamily="{StaticResource Mono}" FontSize="12.5" Margin="0,0,8,0"/>
                                                <!-- Its tooltip is its accessible name (KON-56), so it names
                                                     both the act and the row: a dialog of buttons that all
                                                     say "Show the value" tells a screen reader nothing. -->
                                                <Button Grid.Column="1" Classes="qa" Classes.on="{Binding IsRevealed}"
                                                        Command="{Binding ToggleCommand}" Width="30" Height="30"
                                                        VerticalAlignment="Center" ToolTip.Tip="{Binding RevealTip}">
                                                    <Panel>
                                                        <Path Classes="icon" Width="15" Height="15" IsVisible="{Binding !IsRevealed}"
                                                              Data="{StaticResource IconEye}"/>
                                                        <Path Classes="icon" Width="15" Height="15" IsVisible="{Binding IsRevealed}"
                                                              Data="{StaticResource IconEyeOff}"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>

                                            <!-- Bytes get no text box at all: one keystroke in a keystore
                                                 corrupts the whole of it, and it is not what the value is. -->
                                            <Border IsVisible="{Binding IsBinary}" Background="{DynamicResource SurfaceRaised}"
                                                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSm}" Padding="10,8">
                                                <TextBlock Text="{Binding BinaryNotice}" FontSize="12.5" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding AddKeyCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconPlus}" VerticalAlignment="Center"/>
                                <TextBlock Text="Add key" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border IsVisible="{Binding IsYamlSelected}" Background="{DynamicResource CodeSurface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                    <views:ManifestEditor Text="{Binding Yaml}"/>
                </Border>
            </Panel>

            <!-- The action row the manifest editor already has, unchanged: Check is still the
                 cluster's own dry-run, which is what makes encoding out of sight answerable. -->
            <Grid Grid.Row="2" Margin="24,16" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12.5"
                           TextWrapping="Wrap" Margin="0,0,14,0"
                           IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{Binding StatusBrush}"/>
                <Button Grid.Column="1" Classes="ghost" Margin="0,0,8,0">Close</Button>
                <Button Grid.Column="2" Classes="pill" Margin="0,0,8,0" IsEnabled="{Binding IsDirty}">Revert</Button>
                <Button Grid.Column="3" Classes="pill" Margin="0,0,8,0" IsEnabled="{Binding IsDirty}"
                        ToolTip.Tip="Ask the cluster what this would change, without changing it">Check</Button>
                <Button Grid.Column="4" Classes="primary" IsEnabled="{Binding IsDirty}">Apply</Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
