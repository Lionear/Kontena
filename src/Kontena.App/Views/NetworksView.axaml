<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.NetworksView"
             x:DataType="vm:NetworksViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,22" Spacing="14">
            <TextBlock Text="Networks" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextDim}"/>

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#141821" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,12" ColumnDefinitions="1.4*,.8*,.7*,1.2*,1.4*,68">
                            <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="DRIVER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="SCOPE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="SUBNET" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="ATTACHED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NetworkRowViewModel">
                                <Border Classes="row" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="18,11" ColumnDefinitions="1.4*,.8*,.7*,1.2*,1.4*,68" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}"
                                                       FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Background="{DynamicResource Surface2}">
                                            <TextBlock Text="{Binding Driver}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{Binding DriverBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Scope}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Subnet}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding AttachedText}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa danger" Command="{Binding DeleteCommand}"
                                                    IsVisible="{Binding CanDelete}" ToolTip.Tip="Delete">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextFaint}"
                                                  Data="{StaticResource IconPlug}" IsVisible="{Binding IsBuiltIn}" ToolTip.Tip="Built-in"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
