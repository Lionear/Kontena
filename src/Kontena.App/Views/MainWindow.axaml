<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kontena.App.Controls"
        xmlns:vm="using:Kontena.App.ViewModels"
        xmlns:conv="using:Kontena.App.Converters"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Kontena.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Bg}"
        TransparencyLevelHint="None"
        Icon="/Assets/icon.ico"
        Title="Kontena"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="BorderOnly">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Keyboard (KON-172, configurable since KON-180). The bindings are filled in code from
         ShellActions plus whatever the user changed — see MainWindow.axaml.cs. They are not listed
         here because a gesture named in XAML is one nobody can change, show or check. Bindings live
         on the window, so a control that handles a key first — the terminal, which must keep Ctrl-C
         and Ctrl-R for the process — still wins over them. -->

    <Window.Resources>
        <!-- One switcher row — shared by the Engines and Clusters groups in the popover. -->
        <DataTemplate x:Key="SwitcherItem" x:DataType="vm:EngineOption">
            <Button Classes="engineitem" Classes.active="{Binding IsActive}"
                    IsEnabled="{Binding IsConnected}"
                    Click="OnSwitcherItemClick"
                    Command="{Binding SwitchCommand}" CommandParameter="{Binding Backend}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:BackendChip Grid.Column="0" Chip="{Binding Chip}" ChipSize="30" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <Border Background="#34D39916" CornerRadius="20" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
                                <TextBlock Text="Connected" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Path Grid.Column="2" Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Primary}"
                          Data="{StaticResource IconCheck}" VerticalAlignment="Center" IsVisible="{Binding IsActive}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The same row in the down state, where there is no flyout to close on click. -->
        <DataTemplate x:Key="BackendChoice" x:DataType="vm:EngineOption">
            <Button Classes="engineitem" IsEnabled="{Binding IsConnected}" Margin="0,0,0,2"
                    Command="{Binding SwitchCommand}" CommandParameter="{Binding Backend}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:BackendChip Grid.Column="0" Chip="{Binding Chip}" ChipSize="30" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <Border Background="#34D39916" CornerRadius="20" Padding="6,1" VerticalAlignment="Center"
                                    IsVisible="{Binding IsConnected}">
                                <TextBlock Text="Reachable" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Flat search input: the wrapping Border supplies the frame -->
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Without this the placeholder takes Fluent's own colour, which knows nothing about this
                 palette: on light's Bg there was not enough of it left to read (KON-196). TextFaint is
                 the token for text that is present but quiet, and it is measured against every
                 surface in PaletteContrastTests. -->
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextFaint}"/>
        </Style>
        <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Caption buttons. Square and full-height so the hit target reaches the window's top
             edge, where a thrown pointer lands (KON-138). -->
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="Button.caption.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Button.caption.danger:pointerover Path.icon">
            <Setter Property="Stroke" Value="#FFFFFF"/>
        </Style>

        <!-- Backend switcher pill — full-width, lives at the top of the sidebar -->
        <Style Selector="Button.bkpill">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.bkpill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>

        <!-- Strip default flyout chrome; our Border draws the panel -->
        <Style Selector="FlyoutPresenter.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Button.engineitem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.engineitem:pointerover:not(.active):not(:disabled) /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="Button.engineitem.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
        </Style>
        <Style Selector="Button.engineitem:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <!-- OffScreenMargin is what keeps a maximized window from bleeding past the work area: with the
         client area extended, the frame the OS used to subtract is ours to subtract (KON-134). -->
    <Grid RowDefinitions="38,*" ColumnDefinitions="248,*"
          Margin="{Binding $parent[Window].OffScreenMargin}">

        <!--
            Our own title bar (KON-134, reworked in KON-138). `WindowDecorations="BorderOnly"` means
            nobody else draws one — Avalonia keeps the border, shadow and resize grips, we supply
            the bar. `ElementRole="TitleBar"` is what makes it a title bar rather than a strip that
            looks like one: the platform treats it as non-client area, so dragging and double-click
            are its behaviour, not ours to reimplement.

            The buttons are `DecorationsElement` rather than the CloseButton/MinimizeButton roles.
            Those roles hand the button to the platform — HTCLOSE and friends on Win32 — which is
            exactly the per-platform divergence this window is trying not to have. They stay
            ordinary buttons with ordinary handlers, and the role only keeps them out of the drag
            area.

            Dragging really is the platform's. Double-click is not, whatever the paragraph above
            used to claim (KON-195): with the client area extended, the window manager never sees a
            click on non-client area, so the maximise-on-double-click it would normally do never
            happens. Hence a handler, for the same reason the three buttons have one.
        -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                DoubleTapped="OnTitleBarDoubleTapped"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Panel>
                <!-- "Where am I" belongs here: the space is already reserved and the question is asked
                     often (KON-219). The trail is the app, then the backend that is open and what it
                     is — the same two strings the switcher shows, so the two cannot disagree. -->
                <StackPanel Orientation="Horizontal" Spacing="9"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{StaticResource KontenaLogo}" Width="18" Height="18"/>
                    <TextBlock Text="Kontena" FontSize="13" FontWeight="SemiBold" LetterSpacing="-0.13"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <TextBlock Text="/" FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center" IsVisible="{Binding HasBackendCrumb}"/>
                    <TextBlock Text="{Binding EngineName}" FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               IsVisible="{Binding HasBackendCrumb}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    <TextBlock Text="·" FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center" IsVisible="{Binding HasBackendCrumb}"/>
                    <TextBlock Text="{Binding EngineDetail}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                               IsVisible="{Binding HasBackendCrumb}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                </StackPanel>

                <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            chrome:WindowDecorationProperties.ElementRole="DecorationsElement">
                    <Button Classes="caption" Click="OnMinimiseClick" ToolTip.Tip="Minimise">
                        <Path Classes="icon" Width="14" Height="14" Stretch="None"
                              Stroke="{DynamicResource TextDim}" Data="{StaticResource IconWindowMinimize}"/>
                    </Button>
                    <!-- Glyph and tooltip follow WindowState from code-behind: it is the window's
                         own state, and routing it through the view model to bind to would be a
                         longer way round to the same two values. -->
                    <Button x:Name="MaximiseButton" Classes="caption" Click="OnMaximiseClick">
                        <Path x:Name="MaximiseGlyph" Classes="icon" Width="13" Height="13"
                              Stroke="{DynamicResource TextDim}" Data="{StaticResource IconWindowMaximize}"/>
                    </Button>
                    <Button Classes="caption danger" Click="OnCloseClick" ToolTip.Tip="Close">
                        <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextDim}"
                              Data="{StaticResource IconClose}"/>
                    </Button>
                </StackPanel>
            </Panel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <!-- Brand lockup (KON-133). At 26px next to a 17px wordmark the mark read as one
                     more nav glyph; at 34/20 it reads as the brand. The rule below stops it from
                     forming one block with the backend switcher. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,4,0,16">
                    <Image Source="{StaticResource KontenaLogo}" Width="34" Height="34"/>
                    <TextBlock Text="Kontena" FontSize="20" FontWeight="SemiBold" LetterSpacing="-0.4"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Border}" Margin="4,0,4,14"/>

                <!-- Backend switcher — engines &amp; clusters, grouped -->
                <Button x:Name="BackendPill" DockPanel.Dock="Top" Classes="bkpill" Margin="2,0,2,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:BackendChip Grid.Column="0" Chip="{Binding EngineChip}" ChipSize="26" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding EngineName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <!-- The health dot has to be able to say "not healthy", or it says nothing. -->
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource Success}" IsVisible="{Binding !IsBackendDown}"/>
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource Danger}" IsVisible="{Binding IsBackendDown}"/>
                                <TextBlock Text="{Binding EngineDetail}" FontSize="10.5" FontFamily="{StaticResource Mono}"
                                           Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EngineEndpoint}" FontSize="10.5" FontFamily="{StaticResource Mono}"
                                       Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding EngineEndpoint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Path Grid.Column="2" Classes="icon" Width="13" Height="13" Stroke="{DynamicResource TextFaint}"
                              Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>

                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="flat">
                            <Border Width="280" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="6" BoxShadow="0 12 40 0 #66000000">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="10,8,10,5">
                                        <TextBlock Text="CONTAINER ENGINES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        <Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="150"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Engines}" ItemTemplate="{StaticResource SwitcherItem}"/>

                                    <!-- Clusters · Orchestrators group (only when any clusters are known) -->
                                    <StackPanel Spacing="2" IsVisible="{Binding HasClusters}">
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="10,10,10,5">
                                            <TextBlock Text="CLUSTERS · ORCHESTRATORS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            <Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="120"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Clusters}" ItemTemplate="{StaticResource SwitcherItem}"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Border}" Margin="4,6"/>

                                    <!-- Contexts found in a kubeconfig that have never been offered.
                                         Mentioned, not added: a kubeconfig collects other people's
                                         clusters, and production does not belong one click away by
                                         accident (KON-120). -->
                                    <Button Classes="engineitem" Click="OnSwitcherItemClick"
                                            IsVisible="{Binding HasNewClusters}"
                                            Command="{Binding ReviewNewClustersCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Info}"
                                                  Data="{StaticResource IconInfo}" VerticalAlignment="Center"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding NewClusterNotice}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource Info}"/>
                                                <TextBlock Text="Choose which to show" FontSize="11"
                                                           Foreground="{DynamicResource TextFaint}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="engineitem" Click="OnSwitcherItemClick"
                                            Command="{Binding ShowAddBackendCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Primary}"
                                                  Data="{StaticResource IconPlus}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add engine or cluster…" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                    <!-- Update entry: present only when there is one, and it mirrors the stage (KON-110) -->
                    <Button Classes="nav" Command="{Binding Update.OpenCardCommand}"
                            IsVisible="{Binding Update.HasSidebarEntry}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{DynamicResource Primary}" Data="{StaticResource IconDownload}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Update.SidebarLabel}" Margin="11,0,0,0"
                                       Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="{DynamicResource PrimarySoft}" CornerRadius="{StaticResource Radius}"
                                    Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Update.SidebarPill}" FontSize="11"
                                           FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Primary}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsActivitySelected}" Command="{Binding ShowActivityCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconActivity}"/>
                            <TextBlock Grid.Column="1" Text="Activity" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsSettingsSelected}" Command="{Binding ShowSettingsCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSettings}"/>
                            <TextBlock Grid.Column="1" Text="Settings" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <!-- About is its own screen, not a Settings category (KON-135). -->
                    <Button Classes="nav" Classes.selected="{Binding IsAboutSelected}" Command="{Binding ShowAboutCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconInfo}"/>
                            <TextBlock Grid.Column="1" Text="About" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Nothing to navigate to while no backend is open; a dead nav is worse than none. -->
                <!-- Scrolls because the nav is no longer a fixed height: expanding Workloads adds up to
                     five entries (KON-169), and without this they slide behind the Activity/Settings
                     block pinned to the bottom. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding !IsBackendDown}">
                <ItemsControl ItemsSource="{Binding NavGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavGroup">
                          <StackPanel Margin="0,0,0,10">
                            <!-- A heading only where a group has one: the engine nav is a single
                                 unlabelled run, and a lone heading over the whole list says nothing. -->
                            <TextBlock Text="{Binding Label}" IsVisible="{Binding HasLabel}"
                                       FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.7"
                                       Foreground="{DynamicResource TextFaint}" Margin="10,4,0,5"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                            <!-- One shape for every entry. The per-kind rows under Workloads used to be
                                 indented behind a chevron; the group heading is the grouping now, so an
                                 indent would be a second way of saying the same thing (KON-219). -->
                            <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,0,0,2"
                                    Command="{Binding Command}" CommandParameter="{Binding Key}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{Binding IconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="11,0,0,0" VerticalAlignment="Center"/>

                                    <!-- Something on this page fell over; separate from the count, which
                                         says how many are working (KON-107). -->
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="0,0,7,0"
                                             VerticalAlignment="Center" Fill="{DynamicResource Warn}"
                                             IsVisible="{Binding NeedsAttention}"
                                             ToolTip.Tip="{Binding AttentionTip}"/>
                                    <!-- Only where there is something to count: an empty pill on every
                                         other row is noise that reads as a control (KON-219). -->
                                    <Border Grid.Column="3" Background="{DynamicResource Surface2}" CornerRadius="{StaticResource Radius}"
                                            Padding="7,1" VerticalAlignment="Center" IsVisible="{Binding HasCount}">
                                        <TextBlock Text="{Binding Count}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                    </Border>
                                </Grid>
                            </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="56,*">

            <!-- Command bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0" ColumnDefinitions="Auto,*,Auto">
                    <!-- Back, and the only one there is: Settings, Activity and About had no way back
                         at all before this (KON-173). Hidden rather than disabled when there is no
                         history, because an always-present greyed arrow is chrome nobody reads. -->
                    <Button Grid.Column="0" Classes="qa" Width="30" Height="30" Margin="0,0,12,0"
                            IsVisible="{Binding CanGoBack}" Command="{Binding GoBackCommand}"
                            ToolTip.Tip="{Binding BackTooltipWithHint}">
                        <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource TextDim}"
                              Data="{StaticResource IconArrowLeft}"/>
                    </Button>

                    <!-- Dimmed where the page has nothing to search, so "you cannot type here" is
                         visible before you try rather than after. -->
                    <Border Grid.Column="1" Width="420" Height="34" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            Opacity="{Binding IsSearchEnabled, Converter={x:Static conv:BoolToSearchOpacityConverter.Instance}}"
                            CornerRadius="{StaticResource RadiusSm}" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Classes="icon" Width="15" Height="15"
                                  Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                            <!-- Placeholder and enabled state follow the page (KON-164). The fixed
                                 string used to name containers, images and volumes on a Kubernetes
                                 cluster, where none of the three exist. -->
                            <TextBox x:Name="SearchBox" Classes="bare" Margin="9,0,0,0"
                                     PlaceholderText="{Binding SearchPlaceholder}"
                                     IsEnabled="{Binding IsSearchEnabled}"
                                     Text="{Binding SearchText, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Namespace picker — only in cluster mode -->
                        <Border IsVisible="{Binding IsClusterMode}" Background="{DynamicResource Bg}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                                Height="34" Padding="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextFaint}"
                                      Data="{StaticResource IconBox}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Namespaces}" SelectedItem="{Binding SelectedNamespace, Mode=TwoWay}"
                                          MinWidth="150" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="qa" Width="34" Height="34" Command="{Binding RefreshCurrentPageCommand}" ToolTip.Tip="{Binding RefreshTooltip}">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconRefresh}"/>
                        </Button>
                        <Button Classes="qa" Width="34" Height="34" Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="{Binding ThemeToggleTip}">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource TextDim}"
                                  Data="{Binding ThemeToggleIconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: the active page, a connecting state, or the engine-down state -->
            <Panel Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding IsPageVisible}"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" IsVisible="{Binding IsConnecting}">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                                 Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface2}"/>
                    <TextBlock Text="Connecting to your container engine…" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Engine-down. Yields to Activity, Settings and About: those are the pages you
                     want when nothing else works, so they show instead of this (KON-137). -->
                <ScrollViewer IsVisible="{Binding IsBackendDownVisible}" VerticalAlignment="Center">
                    <Border Classes="card" MaxWidth="520" Padding="34,30" Margin="24" HorizontalAlignment="Center">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Border Width="60" Height="60" CornerRadius="{StaticResource RadiusLg}" Background="#F8717118" HorizontalAlignment="Center">
                                <Path Classes="icon" Width="28" Height="28" Stroke="{DynamicResource Danger}" Data="{StaticResource IconPlug}"/>
                            </Border>
                            <TextBlock Text="{Binding BackendDownTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{Binding BackendDownDetail}" FontSize="13" Foreground="{DynamicResource TextDim}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>

                            <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding ReconnectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource PrimaryInk}" Data="{StaticResource IconRefresh}"/>
                                    <TextBlock Text="Reconnect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!--
                                Both axes are offered here, not just engines: the thing that failed
                                may well have been a cluster, and then "available engines" is not an
                                answer to anything.
                            -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasAlternatives}">
                                <TextBlock Text="CONTAINER ENGINES" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding Engines}" ItemTemplate="{StaticResource BackendChoice}"/>

                                <TextBlock Text="CLUSTERS" FontSize="10.5" FontWeight="SemiBold" IsVisible="{Binding HasClusters}"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <ItemsControl ItemsSource="{Binding Clusters}" ItemTemplate="{StaticResource BackendChoice}"
                                              IsVisible="{Binding HasClusters}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Panel>
        </Grid>

        <!--
            Detail drawer (KON-307): over the list rather than instead of it, so the row you opened
            stays visible and selected behind the scrim. Below the modal overlay in this file on
            purpose — a confirmation raised from inside the drawer has to sit over it, not under.
        -->
        <Panel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsDetailOpen}">
            <!-- The scrim is the click target for "close", so it is a button rather than a Border. -->
            <Button Command="{Binding CloseDetailCommand}" Background="#8C060810" Focusable="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    BorderThickness="0" CornerRadius="0" Padding="0">
                <Button.Styles>
                    <!-- A scrim that lights up under the pointer reads as a control. It is a dismissal. -->
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#8C060810"/>
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#8C060810"/>
                    </Style>
                </Button.Styles>
            </Button>

            <Border Width="{Binding DetailWidth}" HorizontalAlignment="Right" Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                    BoxShadow="-12 0 40 0 #66000000">
                <Grid RowDefinitions="Auto,*">
                    <!--
                        Its own strip rather than floated over the detail's header: that header's
                        right-hand side already carries the object's actions — Uncordon and Drain on a
                        node — and a ✕ laid over them covered the last one. Surface, so it reads as the
                        top of the header block below it rather than as a bar of its own. The ⤢ that
                        opens this in a window of its own joins it here in KON-308.
                    -->
                    <Border Grid.Row="0" Background="{DynamicResource Surface}" Padding="12,8,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                            <!--
                                The drawer is narrow on purpose, and a YAML tab or a wide events table
                                wants the window. Same view model, moved — no reload, same tab.
                            -->
                            <Button Classes="ghost" Command="{Binding OpenDetailAsPageCommand}"
                                    ToolTip.Tip="Open as full page" Padding="7">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}"
                                      Data="{StaticResource IconWindowMaximize}"/>
                            </Button>
                            <Button Classes="ghost" Command="{Binding CloseDetailCommand}" ToolTip.Tip="Close (Esc)"
                                    Padding="7">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}"
                                      Data="{StaticResource IconClose}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ContentControl Grid.Row="1" Content="{Binding Detail}"/>

                    <!--
                        The left edge is the grip. How much of the list you want kept in view depends on
                        the list, so the width is dragged and remembered rather than chosen once in
                        Settings. Grid.RowSpan so the whole edge grips, not just the part beside the
                        content.
                    -->
                    <Thumb Grid.Row="0" Grid.RowSpan="2" Name="DetailResizer" Width="6"
                           HorizontalAlignment="Left" VerticalAlignment="Stretch"
                           Background="Transparent" Cursor="SizeWestEast"
                           DragDelta="OnDetailResize" DragCompleted="OnDetailResized">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </Panel>

        <!-- Modal overlay (Run container, …). Row 1 only: the title bar stays draggable behind it. -->
        <Panel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsDialogOpen}" Background="#B4060810">
            <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="32"/>
        </Panel>

        <!-- Update toast: bottom-right, once per version, never in the way of the content (KON-110) -->
        <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding Update.IsToastVisible}" Width="360"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,14" BoxShadow="0 12 40 0 #66000000">
            <StackPanel Spacing="11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Primary}"
                          Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Update.Version, StringFormat='Kontena {0} is available'}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource TextDim}"
                           Text="Downloads in the background. You choose when to restart."/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding Update.DismissToastCommand}" Content="Later"/>
                    <Button Classes="primary" Command="{Binding Update.OpenCardCommand}" Content="See what's new"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- First-run onboarding: opaque, covers the whole shell below the title bar -->
        <Panel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsOnboarding}" Background="{DynamicResource Bg}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Onboarding}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="24,32"/>
            </ScrollViewer>
        </Panel>
    </Grid>
</Window>
