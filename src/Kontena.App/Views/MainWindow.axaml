<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kontena.App.ViewModels"
        xmlns:conv="using:Kontena.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Kontena.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}"
        TransparencyLevelHint="None"
        Title="Kontena">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Flat search input: the wrapping Border supplies the frame -->
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Backend switcher pill (looks like a dropdown, behaves like a button) -->
        <Style Selector="Button.switcher">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8,0,12,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.switcher:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>

        <!-- Strip default flyout chrome; our Border draws the panel -->
        <Style Selector="FlyoutPresenter.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Button.engineitem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.engineitem:pointerover:not(.active):not(:disabled) /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="Button.engineitem.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
        </Style>
        <Style Selector="Button.engineitem:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="222,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,4,0,20">
                    <Canvas Width="26" Height="26">
                        <Border Canvas.Left="0" Canvas.Top="0" Width="13" Height="13" CornerRadius="4" Background="{StaticResource Primary}"/>
                        <Border Canvas.Left="13" Canvas.Top="3" Width="13" Height="13" CornerRadius="4" Background="{StaticResource Accent}" Opacity="0.9"/>
                        <Border Canvas.Left="5" Canvas.Top="13" Width="13" Height="13" CornerRadius="4" Background="#0F9E7E" Opacity="0.85"/>
                    </Canvas>
                    <TextBlock Text="Kontena" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                    <Button Classes="nav">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconActivity}"/>
                            <TextBlock Grid.Column="1" Text="Activity" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSettings}"/>
                            <TextBlock Grid.Column="1" Text="Settings" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavItems}" DockPanel.Dock="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,0,0,2"
                                    Command="{Binding Command}" CommandParameter="{Binding Key}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{Binding IconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="56,*">

            <!-- Command bar -->
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0" ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Width="420" Height="34" Background="{StaticResource Bg}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Classes="icon" Width="15" Height="15"
                                  Stroke="{StaticResource TextFaint}" Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                            <TextBox Classes="bare" Margin="9,0,0,0"
                                     PlaceholderText="Search containers, images, volumes…"
                                     Text="{Binding SearchText, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <!-- Backend switcher (working dropdown) -->
                    <Button Grid.Column="2" Classes="switcher" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource DockerChip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EngineChip}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12"
                                           Foreground="#2496ED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding EngineName}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                            <Panel Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="#34D399" Opacity="0.25"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Success}"/>
                            </Panel>
                            <Path Classes="icon" Width="12" Height="12" Stroke="{StaticResource TextFaint}"
                                  Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" Margin="1,1,0,0"/>
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="flat">
                                <Border Width="280" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="10" Padding="6" BoxShadow="0 12 40 0 #66000000">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="ENGINES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="10,8,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Engines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EngineOption">
                                                    <Button Classes="engineitem" Classes.active="{Binding IsActive}"
                                                            IsEnabled="{Binding IsConnected}"
                                                            Command="{Binding SwitchCommand}" CommandParameter="{Binding Backend}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                                                    Background="{StaticResource DockerChip}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Chip}" FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                                                           FontSize="13" Foreground="#2496ED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                                    <Border Background="#34D39916" CornerRadius="20" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
                                                                        <TextBlock Text="Connected" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                                           Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Path Grid.Column="2" Classes="icon" Width="16" Height="16" Stroke="{StaticResource Primary}"
                                                                  Data="{StaticResource IconCheck}" VerticalAlignment="Center" IsVisible="{Binding IsActive}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Height="1" Background="{StaticResource Border}" Margin="4,6"/>
                                        <Button Classes="engineitem">
                                            <StackPanel Orientation="Horizontal" Spacing="11">
                                                <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource TextDim}"
                                                      Data="{StaticResource IconPlug}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Connect a remote engine…" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="qa" Width="34" Height="34" Command="{Binding RefreshCurrentPageCommand}" ToolTip.Tip="Refresh">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{StaticResource TextDim}" Data="{StaticResource IconRefresh}"/>
                        </Button>
                        <Button Classes="qa" Width="34" Height="34" ToolTip.Tip="Toggle theme">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{StaticResource TextDim}" Data="{StaticResource IconMoon}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: the active page, or a connecting state -->
            <Panel Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding IsReady}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" IsVisible="{Binding !IsReady}">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                                 Foreground="{StaticResource Primary}" Background="{StaticResource Surface2}"/>
                    <TextBlock Text="Connecting to your container engine…" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Panel>
        </Grid>
    </Grid>
</Window>
