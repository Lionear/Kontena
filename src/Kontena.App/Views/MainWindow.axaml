<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kontena.App.ViewModels"
        xmlns:conv="using:Kontena.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Kontena.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Bg}"
        TransparencyLevelHint="None"
        Icon="/Assets/icon.ico"
        Title="Kontena">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- One switcher row — shared by the Engines and Clusters groups in the popover. -->
        <DataTemplate x:Key="SwitcherItem" x:DataType="vm:EngineOption">
            <Button Classes="engineitem" Classes.active="{Binding IsActive}"
                    IsEnabled="{Binding IsConnected}"
                    Click="OnSwitcherItemClick"
                    Command="{Binding SwitchCommand}" CommandParameter="{Binding Backend}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                            Background="{DynamicResource DockerChip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Chip}" FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                   FontSize="12" Foreground="#2496ED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <Border Background="#34D39916" CornerRadius="20" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
                                <TextBlock Text="Connected" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Path Grid.Column="2" Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Primary}"
                          Data="{StaticResource IconCheck}" VerticalAlignment="Center" IsVisible="{Binding IsActive}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The same row in the down state, where there is no flyout to close on click. -->
        <DataTemplate x:Key="BackendChoice" x:DataType="vm:EngineOption">
            <Button Classes="engineitem" IsEnabled="{Binding IsConnected}" Margin="0,0,0,2"
                    Command="{Binding SwitchCommand}" CommandParameter="{Binding Backend}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                            Background="{DynamicResource DockerChip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Chip}" FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                   FontSize="13" Foreground="{DynamicResource Info}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <Border Background="#34D39916" CornerRadius="20" Padding="6,1" VerticalAlignment="Center"
                                    IsVisible="{Binding IsConnected}">
                                <TextBlock Text="Reachable" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                   Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Flat search input: the wrapping Border supplies the frame -->
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Backend switcher pill — full-width, lives at the top of the sidebar -->
        <Style Selector="Button.bkpill">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.bkpill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>

        <!-- Strip default flyout chrome; our Border draws the panel -->
        <Style Selector="FlyoutPresenter.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Button.engineitem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.engineitem:pointerover:not(.active):not(:disabled) /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="Button.engineitem.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
        </Style>
        <Style Selector="Button.engineitem:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="248,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,4,0,14">
                    <Image Source="{StaticResource KontenaLogo}" Width="26" Height="26"/>
                    <TextBlock Text="Kontena" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Backend switcher — engines &amp; clusters, grouped -->
                <Button x:Name="BackendPill" DockPanel.Dock="Top" Classes="bkpill" Margin="2,0,2,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource DockerChip}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EngineChip}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11"
                                       Foreground="#2496ED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding EngineName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <!-- The health dot has to be able to say "not healthy", or it says nothing. -->
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource Success}" IsVisible="{Binding !IsBackendDown}"/>
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource Danger}" IsVisible="{Binding IsBackendDown}"/>
                                <TextBlock Text="{Binding EngineDetail}" FontSize="10.5" FontFamily="{StaticResource Mono}"
                                           Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EngineEndpoint}" FontSize="10.5" FontFamily="{StaticResource Mono}"
                                       Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding EngineEndpoint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Path Grid.Column="2" Classes="icon" Width="13" Height="13" Stroke="{DynamicResource TextFaint}"
                              Data="{StaticResource IconChevronDown}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>

                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="flat">
                            <Border Width="280" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" Padding="6" BoxShadow="0 12 40 0 #66000000">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="10,8,10,5">
                                        <TextBlock Text="CONTAINER ENGINES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        <Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="150"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Engines}" ItemTemplate="{StaticResource SwitcherItem}"/>

                                    <!-- Clusters · Orchestrators group (only when any clusters are known) -->
                                    <StackPanel Spacing="2" IsVisible="{Binding HasClusters}">
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="10,10,10,5">
                                            <TextBlock Text="CLUSTERS · ORCHESTRATORS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            <Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="120"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Clusters}" ItemTemplate="{StaticResource SwitcherItem}"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Border}" Margin="4,6"/>
                                    <Button Classes="engineitem" Click="OnSwitcherItemClick"
                                            Command="{Binding ShowAddBackendCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Primary}"
                                                  Data="{StaticResource IconPlus}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add engine or cluster…" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                    <!-- Update entry: present only when there is one, and it mirrors the stage (KON-110) -->
                    <Button Classes="nav" Command="{Binding Update.OpenCardCommand}"
                            IsVisible="{Binding Update.HasSidebarEntry}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{DynamicResource Primary}" Data="{StaticResource IconDownload}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Update.SidebarLabel}" Margin="11,0,0,0"
                                       Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="{DynamicResource PrimarySoft}" CornerRadius="10"
                                    Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Update.SidebarPill}" FontSize="11"
                                           FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Primary}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsActivitySelected}" Command="{Binding ShowActivityCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconActivity}"/>
                            <TextBlock Grid.Column="1" Text="Activity" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsSettingsSelected}" Command="{Binding ShowSettingsCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                  Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSettings}"/>
                            <TextBlock Grid.Column="1" Text="Settings" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Nothing to navigate to while no backend is open; a dead nav is worse than none. -->
                <ItemsControl ItemsSource="{Binding NavItems}" DockPanel.Dock="Top"
                              IsVisible="{Binding !IsBackendDown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,0,0,2"
                                    Command="{Binding Command}" CommandParameter="{Binding Key}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{Binding IconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="11,0,0,0" VerticalAlignment="Center"/>

                                    <!-- Something on this page fell over; separate from the count, which
                                         says how many are working (KON-107). -->
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="0,0,7,0"
                                             VerticalAlignment="Center" Fill="{DynamicResource Warn}"
                                             IsVisible="{Binding NeedsAttention}"
                                             ToolTip.Tip="{Binding AttentionTip}"/>
                                    <Border Grid.Column="3" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="56,*">

            <!-- Command bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0" ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Width="420" Height="34" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Classes="icon" Width="15" Height="15"
                                  Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                            <TextBox Classes="bare" Margin="9,0,0,0"
                                     PlaceholderText="Search containers, images, volumes…"
                                     Text="{Binding SearchText, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Namespace picker — only in cluster mode -->
                        <Border IsVisible="{Binding IsClusterMode}" Background="{DynamicResource Bg}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"
                                Height="34" Padding="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextFaint}"
                                      Data="{StaticResource IconBox}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Namespaces}" SelectedItem="{Binding SelectedNamespace, Mode=TwoWay}"
                                          MinWidth="150" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="qa" Width="34" Height="34" Command="{Binding RefreshCurrentPageCommand}" ToolTip.Tip="Refresh">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconRefresh}"/>
                        </Button>
                        <Button Classes="qa" Width="34" Height="34" Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="{Binding ThemeToggleTip}">
                            <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource TextDim}"
                                  Data="{Binding ThemeToggleIconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: the active page, a connecting state, or the engine-down state -->
            <Panel Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding IsReady}"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" IsVisible="{Binding IsConnecting}">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                                 Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface2}"/>
                    <TextBlock Text="Connecting to your container engine…" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Engine-down -->
                <ScrollViewer IsVisible="{Binding IsBackendDown}" VerticalAlignment="Center">
                    <Border Classes="card" MaxWidth="520" Padding="34,30" Margin="24" HorizontalAlignment="Center">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Border Width="60" Height="60" CornerRadius="15" Background="#F8717118" HorizontalAlignment="Center">
                                <Path Classes="icon" Width="28" Height="28" Stroke="{DynamicResource Danger}" Data="{StaticResource IconPlug}"/>
                            </Border>
                            <TextBlock Text="{Binding BackendDownTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{Binding BackendDownDetail}" FontSize="13" Foreground="{DynamicResource TextDim}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>

                            <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding ReconnectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource PrimaryInk}" Data="{StaticResource IconRefresh}"/>
                                    <TextBlock Text="Reconnect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!--
                                Both axes are offered here, not just engines: the thing that failed
                                may well have been a cluster, and then "available engines" is not an
                                answer to anything.
                            -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasAlternatives}">
                                <TextBlock Text="CONTAINER ENGINES" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding Engines}" ItemTemplate="{StaticResource BackendChoice}"/>

                                <TextBlock Text="CLUSTERS" FontSize="10.5" FontWeight="SemiBold" IsVisible="{Binding HasClusters}"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <ItemsControl ItemsSource="{Binding Clusters}" ItemTemplate="{StaticResource BackendChoice}"
                                              IsVisible="{Binding HasClusters}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Panel>
        </Grid>

        <!-- Modal overlay (Run container, …) -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsDialogOpen}" Background="#B4060810">
            <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="32"/>
        </Panel>

        <!-- Update toast: bottom-right, once per version, never in the way of the content (KON-110) -->
        <Border Grid.Column="1" IsVisible="{Binding Update.IsToastVisible}" Width="360"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="12" Padding="16,14" BoxShadow="0 12 40 0 #66000000">
            <StackPanel Spacing="11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Primary}"
                          Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Update.Version, StringFormat='Kontena {0} is available'}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource TextDim}"
                           Text="Downloads in the background. You choose when to restart."/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding Update.DismissToastCommand}" Content="Later"/>
                    <Button Classes="primary" Command="{Binding Update.OpenCardCommand}" Content="See what's new"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- First-run onboarding: full-window, opaque, covers the whole shell -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsOnboarding}" Background="{DynamicResource Bg}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Onboarding}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="24,32"/>
            </ScrollViewer>
        </Panel>
    </Grid>
</Window>
