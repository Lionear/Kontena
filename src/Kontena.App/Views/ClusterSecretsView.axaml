<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterSecretsView"
             x:DataType="vm:ClusterSecretsViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <TextBlock Text="Secrets" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="Keys and their sizes. A value is fetched from the cluster the moment you ask for it, and dropped again when you hide it."
                       FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    IsVisible="{Binding HasItems}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="24,1.8*,1*,1.6*,0.8*,0.6*,140">
                            <TextBlock Grid.Column="1" Text="NAME" Classes="colhead"/>
                            <TextBlock Grid.Column="2" Text="NAMESPACE" Classes="colhead"/>
                            <TextBlock Grid.Column="3" Text="TYPE" Classes="colhead"/>
                            <TextBlock Grid.Column="4" Text="KEYS" Classes="colhead"/>
                            <TextBlock Grid.Column="5" Text="AGE" Classes="colhead"/>
                            <TextBlock Grid.Column="6" Text="" Classes="colhead" MinWidth="132"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConfigObjectRow">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                        <Grid ColumnDefinitions="24,1.8*,1*,1.6*,0.8*,0.6*,140">
                                            <!-- Same expander as the projects rows in Containers: a bare
                                                 quick-action button and a sized icon, swapped for the open
                                                 state rather than left pointing the wrong way. -->
                                            <Button Grid.Column="0" Classes="qa bare" Width="22" Height="22" Margin="-2,0,0,0"
                                                    Command="{Binding ToggleCommand}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    IsVisible="{Binding CanExpand}" ToolTip.Tip="Show the keys">
                                                <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconChevronRight}"/>
                                            </Button>
                                            <Button Grid.Column="0" Classes="qa bare" Width="22" Height="22" Margin="-2,0,0,0"
                                                    Command="{Binding ToggleCommand}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    IsVisible="{Binding CanCollapse}" ToolTip.Tip="Hide the keys">
                                                <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconChevronDown}"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Namespace}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Type}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding KeyCount}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Classes="pill" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}"
                                                        ToolTip.Tip="Edit the live manifest">Edit</Button>
                                                <Button Classes="pill" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}">Delete</Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- The keys. Opening this fetches nothing: the names and sizes came with
                                         the listing, and the value only moves when Show is pressed. -->
                                    <Border IsVisible="{Binding IsExpanded}" Background="{DynamicResource SurfaceRaised}"
                                            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="42,10,16,12">
                                        <ItemsControl ItemsSource="{Binding Keys}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ConfigKeyRow">
                                                    <StackPanel Margin="0,4">
                                                        <Grid ColumnDefinitions="1.4*,0.6*,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                       Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Size}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                                       Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Classes="pill" Command="{Binding ToggleCommand}"
                                                                    IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0">
                                                                <Panel>
                                                                    <TextBlock Text="Show" IsVisible="{Binding !IsRevealed}"/>
                                                                    <TextBlock Text="Hide" IsVisible="{Binding IsRevealed}"/>
                                                                </Panel>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="pill" Click="CopyValue" Tag="{Binding}"
                                                                    ToolTip.Tip="Copy the value without putting it on screen">Copy</Button>
                                                        </Grid>

                                                        <!-- Revealed, and only while revealed: hiding drops the value rather
                                                             than folding it away. -->
                                                        <Border IsVisible="{Binding IsRevealed}" Margin="0,6,0,0"
                                                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,8">
                                                            <StackPanel>
                                                                <SelectableTextBlock Text="{Binding Value}" IsVisible="{Binding !IsBinary}"
                                                                                     FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                                     Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                                                <!-- Bytes are never drawn as characters: half a TLS key rendered as
                                                                     text is noise, and it is not what the value is. -->
                                                                <TextBlock Text="{Binding BinaryNotice}" IsVisible="{Binding IsBinary}"
                                                                           FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource TextDim}"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                                                   Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsEmpty}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No secrets in this namespace." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No secrets match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
