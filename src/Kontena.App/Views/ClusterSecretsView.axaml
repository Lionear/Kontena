<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterSecretsView"
             x:DataType="vm:ClusterSecretsViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <TextBlock Text="Secrets" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="Keys and their sizes. Open a secret to see them: a value is fetched from the cluster the moment you ask for it, and dropped again when you hide it."
                       FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    IsVisible="{Binding HasItems}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="1.8*,1*,1.6*,0.8*,0.6*,140">
                            <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
                            <TextBlock Grid.Column="1" Text="NAMESPACE" Classes="colhead"/>
                            <TextBlock Grid.Column="2" Text="TYPE" Classes="colhead"/>
                            <TextBlock Grid.Column="3" Text="KEYS" Classes="colhead"/>
                            <TextBlock Grid.Column="4" Text="AGE" Classes="colhead"/>
                            <TextBlock Grid.Column="5" Text="" Classes="colhead" MinWidth="132"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConfigObjectRow">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <Grid ColumnDefinitions="1.8*,1*,1.6*,0.8*,0.6*,140">
                                        <!-- The name opens the detail, like every other cluster list
                                             (KON-330). The expander that used to sit left of it is gone:
                                             the keys live in the detail now, and two places to reveal a
                                             value is one more than this page should have. -->
                                        <Button Grid.Column="0" Classes="link" HorizontalAlignment="Left" Command="{Binding OpenCommand}"
                                                IsEnabled="{Binding CanOpen}" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Namespace}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding KeyCount}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="pill" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}"
                                                    ToolTip.Tip="Edit the live manifest">Edit</Button>
                                            <Button Classes="pill" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}">Delete</Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsEmpty}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No secrets in this namespace." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No secrets match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
