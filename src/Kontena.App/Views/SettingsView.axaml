<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.snav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Button.snav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="Button.snav.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- Compact switch -->
        <Style Selector="ToggleSwitch.pill">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
        </Style>

        <Style Selector="TextBlock.gh">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="216,*">

        <!-- Sub-nav -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,22">
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"
                           Margin="10,0,0,12"/>
                <Button Classes="snav" Classes.on="{Binding IsGeneral}" Command="{Binding SelectCategoryCommand}" CommandParameter="general">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSettings}"/>
                        <TextBlock Grid.Column="1" Text="General" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsEngines}" Command="{Binding SelectCategoryCommand}" CommandParameter="engines">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconContainer}"/>
                        <TextBlock Grid.Column="1" Text="Engines" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsRegistries}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="registries" IsVisible="{Binding HasRegistries}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconLayers}"/>
                        <TextBlock Grid.Column="1" Text="Registries" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsUpdates}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="updates" IsVisible="{Binding HasUpdates}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconDownload}"/>
                        <TextBlock Grid.Column="1" Text="Updates" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsAbout}" Command="{Binding SelectCategoryCommand}" CommandParameter="about">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconInfo}"/>
                        <TextBlock Grid.Column="1" Text="About" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="34,28" MaxWidth="860" HorizontalAlignment="Stretch">

                <!-- General -->
                <StackPanel IsVisible="{Binding IsGeneral}" Spacing="0">
                    <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Appearance and terminal." FontSize="13.5" Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <TextBlock Classes="gh" Text="APPEARANCE"/>
                    <Border Classes="card" Padding="0" Margin="0,0,0,30">
                      <StackPanel>
                        <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Kontena follows your OS by default. Override it here." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="seg" Classes.on="{Binding IsLightTheme}" Command="{Binding SetThemeCommand}" CommandParameter="light">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSun}"/>
                                            <TextBlock Text="Light" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="seg" Classes.on="{Binding IsDarkTheme}" Command="{Binding SetThemeCommand}" CommandParameter="dark">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconMoon}"/>
                                            <TextBlock Text="Dark" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="seg" Classes.on="{Binding IsSystemTheme}" Command="{Binding SetThemeCommand}" CommandParameter="system">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconMonitor}"/>
                                            <TextBlock Text="System" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Border}"/>
                        <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Compact density" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Tighter rows in the container, image, volume and network lists." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding CompactDensity, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Hidden where autostart cannot work — see CanLaunchAtLogin (KON-103). -->
                    <TextBlock Classes="gh" Text="STARTUP" IsVisible="{Binding CanLaunchAtLogin}"/>
                    <Border Classes="card" Padding="0" IsVisible="{Binding CanLaunchAtLogin}">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Launch Kontena at login" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Start Kontena when you sign in. You can also turn this off in your desktop's own startup settings."
                                               FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="TERMINAL" Margin="0,30,0,12"/>
                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Font" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Monospace family for the container shell." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                          ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding TerminalFontFamily, Mode=TwoWay}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Font size" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Applies to terminals you open next." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider Width="150" Minimum="9" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding TerminalFontSize, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TerminalFontSize}" FontFamily="{StaticResource Mono}" FontSize="13"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" MinWidth="24"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Ligatures" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Render programming-font ligatures (e.g. → and ≠)." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding TerminalLigatures, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Engines -->
                <StackPanel IsVisible="{Binding IsEngines}" Spacing="0">
                    <TextBlock Text="Engines" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="How Kontena discovers and selects your container engines." FontSize="13.5" Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <Border Classes="card" Padding="0" Margin="0,0,0,30">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-detect engines" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Watch for Docker, Podman and (later) Apple container starting or stopping." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding AutoDetect, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="On launch" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding StartupHint}" FontSize="12" Foreground="{DynamicResource TextDim}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="210" VerticalAlignment="Center"
                                          ItemsSource="{Binding StartupOptions}"
                                          SelectedItem="{Binding SelectedStartup, Mode=TwoWay}"/>
                            </Grid>
                            <!-- Development only: hidden entirely in an ordinary release build -->
                            <Border Height="1" Background="{DynamicResource Border}" IsVisible="{Binding CanToggleDemoBackends}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto" IsVisible="{Binding CanToggleDemoBackends}">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <TextBlock Text="Demo backends" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="DEV" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Show the in-memory fake engine and clusters alongside the real ones. Turn off to work against real backends only." FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding ShowDemoBackends, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="DETECTED ENGINES"/>
                    <Border Classes="card" Padding="0">
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EngineListItem">
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                        <Grid Margin="18,14" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource DockerChip}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Chip}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="16"
                                                           Foreground="{DynamicResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                    <Border Background="#34D39916" CornerRadius="20" Padding="7,2" VerticalAlignment="Center" IsVisible="{Binding Connected}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Connected" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="20" Padding="7,2" VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="Default" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="12" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextDim}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Registries (KON-114) -->
                <StackPanel IsVisible="{Binding IsRegistries}" Spacing="0">
                    <TextBlock Text="Registries" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Sign in to pull private images. Passwords and tokens go to your system keychain, never to a file."
                               FontSize="13.5" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <TextBlock Classes="gh" Text="SIGN IN"/>
                    <Border Classes="card" Margin="0,0,0,30">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="7">
                                    <TextBlock Text="REGISTRY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RegistryHostInput, Mode=TwoWay}" PlaceholderText="ghcr.io"
                                             FontFamily="{StaticResource Mono}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="7">
                                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RegistryUsername, Mode=TwoWay}" PlaceholderText="your-account"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="7">
                                <TextBlock Text="PASSWORD OR TOKEN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                <TextBox Text="{Binding RegistrySecret, Mode=TwoWay}" PasswordChar="•"/>
                                <TextBlock Text="For most registries a token is the right answer, not your account password."
                                           FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RegistryError}" FontSize="12.5" TextWrapping="Wrap"
                                       IsVisible="{Binding RegistryError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Danger}"/>
                            <TextBlock Text="{Binding RegistryNotice}" FontSize="12.5"
                                       IsVisible="{Binding RegistryNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Success}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFaint}"
                                           Text="Kontena checks the login with the registry before saving it."/>
                                <Button Grid.Column="1" Classes="primary" Command="{Binding LogInCommand}"
                                        IsEnabled="{Binding CanLogIn}" Content="Sign in"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="SIGNED IN"/>
                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Registries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RegistryRow">
                                        <Grid Margin="18,14" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Host}" FontSize="13.5" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsInherited}" Content="Sign out"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SignOutCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="18,16" FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                                       IsVisible="{Binding !Registries.Count}"
                                       Text="No registry logins yet. Public images need none."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Updates (KON-110) -->
                <StackPanel IsVisible="{Binding IsUpdates}" Spacing="0">
                    <TextBlock Text="Updates" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Which builds Kontena offers, and when it fetches them." FontSize="13.5"
                               Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <!-- An install that cannot replace itself says so before offering any of the rows below -->
                    <Border Classes="card" Margin="0,0,0,30" IsVisible="{Binding ShowUnsupportedNotice}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Info}"
                                  Data="{StaticResource IconInfo}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Update.UnsupportedReason}" FontSize="12.5" TextWrapping="Wrap"
                                       LineHeight="19" Foreground="{DynamicResource TextDim}" MaxWidth="640"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding ShowUpdatePreferences}" Spacing="0">
                        <TextBlock Classes="gh" Text="CHANNEL"/>
                        <Border Classes="card" Padding="0" Margin="0,0,0,30">
                            <StackPanel>
                                <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Release channel" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="{Binding ChannelHint}" FontSize="12" TextWrapping="Wrap"
                                                   MaxWidth="470" Foreground="{DynamicResource TextDim}"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="seg" Classes.on="{Binding IsStableChannel}"
                                                    Command="{Binding SetUpdateChannelCommand}" CommandParameter="stable">
                                                <TextBlock Text="Stable" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="seg" Classes.on="{Binding IsPreviewChannel}"
                                                    Command="{Binding SetUpdateChannelCommand}" CommandParameter="preview">
                                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="seg" Classes.on="{Binding IsNightlyChannel}"
                                                    Command="{Binding SetUpdateChannelCommand}" CommandParameter="nightly">
                                                <TextBlock Text="Nightly" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}"/>
                                <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Download updates automatically" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Fetch a new version as soon as it is found, so the update is a restart rather than a wait."
                                                   FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                                   Foreground="{DynamicResource TextDim}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="gh" Text="THIS INSTALL"/>
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}">
                                        <Run Text="Version"/><Run Text=" "/><Run Text="{Binding Version}" FontFamily="{StaticResource Mono}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Update.SidebarLabel}" FontSize="12"
                                               Foreground="{DynamicResource Primary}" IsVisible="{Binding Update.HasSidebarEntry}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Command="{Binding CheckForUpdatesCommand}"
                                        Content="Check now" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- About -->
                <StackPanel IsVisible="{Binding IsAbout}" Spacing="0">
                    <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="One UI. Any engine. Zero friction." FontSize="13.5" Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Image Source="{StaticResource KontenaLogo}" Width="36" Height="36" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Kontena" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextDim}">
                                        <Run Text="Version"/><Run Text=" "/><Run Text="{Binding Version}" FontFamily="{StaticResource Mono}"/>
                                        <Run Text="  ·  source-available"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                                       Text="A cross-platform desktop app to manage containers through one UI, regardless of the underlying runtime engine — Docker, Podman, and (later) Apple container."/>
                            <TextBlock FontSize="12.5" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextDim}"
                                       Text="github.com/Lionear/Kontena  ·  kontena.app"/>
                            <Border Height="1" Background="{DynamicResource Border}"/>

                            <!-- Says whether the guarantee in CONTRIBUTING actually holds here (KON-52). -->
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Classes="icon" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Stroke="{DynamicResource Info}" Data="{StaticResource IconInfo}"/>
                                <TextBlock Text="{Binding KeychainStatus}" FontSize="12.5" TextWrapping="Wrap"
                                           LineHeight="19" HorizontalAlignment="Left" MaxWidth="620"
                                           Foreground="{DynamicResource TextFaint}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
