<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.snav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Button.snav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="Button.snav.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- Compact switch -->
        <Style Selector="ToggleSwitch.pill">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
        </Style>

        <!-- The gesture button (KON-180): a field that shows keys and takes keys, so it reads as
             mono like every other literal value in the app. -->
        <Style Selector="Button.gesture">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.gesture:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="Button.gesture.recording">
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
        </Style>

        <Style Selector="TextBlock.gh">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Where a remote's own row lands after "Manage below" (KON-264). It is a pointer, not a
             selection: the tint fades on its own after a moment, because nothing was chosen and
             leaving it lit would say otherwise. -->
        <Style Selector="ItemsControl#RemoteRows > ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.45"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl#RemoteRows > ContentPresenter.revealed">
            <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="216,*">

        <!-- Sub-nav -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,22">
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"
                           Margin="10,0,0,12"/>
                <Button Classes="snav" Classes.on="{Binding IsGeneral}" Command="{Binding SelectCategoryCommand}" CommandParameter="general">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSettings}"/>
                        <TextBlock Grid.Column="1" Text="General" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsEngines}" Command="{Binding SelectCategoryCommand}" CommandParameter="engines">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconContainer}"/>
                        <TextBlock Grid.Column="1" Text="Engines" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsRegistries}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="registries" IsVisible="{Binding HasRegistries}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconLayers}"/>
                        <TextBlock Grid.Column="1" Text="Registries" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsUpdates}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="updates" IsVisible="{Binding HasUpdates}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconDownload}"/>
                        <TextBlock Grid.Column="1" Text="Updates" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsTools}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="tools" IsVisible="{Binding Tools, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconTerminal}"/>
                        <TextBlock Grid.Column="1" Text="Tools" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsClusters}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="clusters" IsVisible="{Binding LocalClusters, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconCluster}"/>
                        <TextBlock Grid.Column="1" Text="Local clusters" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Classes="snav" Classes.on="{Binding IsRemoteClusters}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="remote-clusters" IsVisible="{Binding RemoteClusters, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconCluster}"/>
                        <TextBlock Grid.Column="1" Text="Roll out a cluster" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="34,28" MaxWidth="860" HorizontalAlignment="Stretch">

                <!-- General -->
                <StackPanel IsVisible="{Binding IsGeneral}" Spacing="0">
                    <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Appearance, alerts, terminal and keyboard." FontSize="13.5" Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <TextBlock Classes="gh" Text="APPEARANCE"/>
                    <Border Classes="card" Padding="0" Margin="0,0,0,30">
                      <StackPanel>
                        <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Kontena follows your OS by default. Override it here." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="seg" Classes.on="{Binding IsLightTheme}" Command="{Binding SetThemeCommand}" CommandParameter="light">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSun}"/>
                                            <TextBlock Text="Light" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="seg" Classes.on="{Binding IsDarkTheme}" Command="{Binding SetThemeCommand}" CommandParameter="dark">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconMoon}"/>
                                            <TextBlock Text="Dark" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="seg" Classes.on="{Binding IsSystemTheme}" Command="{Binding SetThemeCommand}" CommandParameter="system">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconMonitor}"/>
                                            <TextBlock Text="System" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Border}"/>
                        <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Compact density" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Tighter rows in the container, image, volume and network lists." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding CompactDensity, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Hidden where autostart cannot work — see CanLaunchAtLogin (KON-103). -->
                    <TextBlock Classes="gh" Text="STARTUP" IsVisible="{Binding CanLaunchAtLogin}"/>
                    <Border Classes="card" Padding="0" IsVisible="{Binding CanLaunchAtLogin}">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Launch Kontena at login" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Start Kontena when you sign in. You can also turn this off in your desktop's own startup settings."
                                               FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Alerts (KON-393). Under General with the other preferences rather than in a
                         section of its own: it is one choice, and the two cluster sections next door
                         are provisioning tools, not settings. -->
                    <TextBlock Classes="gh" Text="ALERTS" Margin="0,30,0,12"/>
                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Re-read the Alerts page" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Alertmanager has no watch stream, so the Alerts page cannot follow the cluster the way the other pages do."
                                               FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"/>
                                    <TextBlock Text="{Binding AlertRefreshHint}" FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextFaint}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                          ItemsSource="{Binding AlertRefreshOptions}"
                                          SelectedItem="{Binding AlertRefreshChoice, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostics (KON-389). Off by default: it is for the session after something
                         went wrong, and the file says what Kontena did, not what is in your cluster. -->
                    <TextBlock Classes="gh" Text="DIAGNOSTICS" Margin="0,30,0,12"/>
                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Write a diagnostic log" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Records what you did in Kontena and how much memory it was using, so a crash can be looked at afterwards. Credentials, kubeconfig and manifest content are never written."
                                               FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"/>
                                    <TextBlock Text="{Binding DiagnosticLogPath}" FontFamily="{StaticResource Mono}" FontSize="12"
                                               TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextFaint}"/>
                                    <TextBlock Text="The previous session's log is kept beside it as .prev; the one before that is replaced."
                                               FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextFaint}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding DiagnosticLogging, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="TERMINAL" Margin="0,30,0,12"/>
                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Font" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Monospace family for the container shell." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                          ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding TerminalFontFamily, Mode=TwoWay}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Font size" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Applies to terminals you open next." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider Width="150" Minimum="9" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding TerminalFontSize, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TerminalFontSize}" FontFamily="{StaticResource Mono}" FontSize="13"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" MinWidth="24"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Ligatures" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Render programming-font ligatures (e.g. → and ≠)." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding TerminalLigatures, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Keyboard (KON-180). Under General because there are five of these; a list of
                         thirty would want its own page, the way Registries and Updates have one. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,30,0,12">
                        <TextBlock Grid.Column="0" Classes="gh" Text="KEYBOARD" Margin="0"/>
                        <Button Grid.Column="1" Classes="ghost" Padding="8,3" FontSize="12"
                                IsVisible="{Binding HasCustomShortcuts}"
                                Command="{Binding ResetAllShortcutsCommand}"
                                Content="Restore defaults"/>
                    </Grid>
                    <Border Classes="card" Padding="0">
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutRow">
                                    <StackPanel>
                                        <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock Text="{Binding Problem}" FontSize="12" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasProblem}"
                                                           Foreground="{DynamicResource Danger}"/>
                                            </StackPanel>
                                            <!-- The reset slot is reserved rather than added: a column
                                                 that only exists on changed rows walks the gesture
                                                 buttons out of line down the list. -->
                                            <Grid Grid.Column="1" ColumnDefinitions="Auto,8,30" VerticalAlignment="Center">
                                                <!-- The gesture is pressed, not typed: KeyGesture.Parse throws on
                                                     anything that is not one, and the keys are what people know. -->
                                                <Button Grid.Column="0" Classes="gesture" Classes.recording="{Binding IsRecording}"
                                                        Command="{Binding RecordCommand}"
                                                        ToolTip.Tip="Press the keys you want. Escape cancels.">
                                                    <Panel>
                                                        <TextBlock Text="{Binding DisplayGesture}" IsVisible="{Binding !IsRecording}"/>
                                                        <TextBlock Text="Press keys…" IsVisible="{Binding IsRecording}"
                                                                   Foreground="{DynamicResource Primary}"/>
                                                    </Panel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="qa" Width="30" Height="30"
                                                        IsVisible="{Binding !IsDefault}"
                                                        Command="{Binding ResetCommand}"
                                                        ToolTip.Tip="Restore the default">
                                                    <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource TextDim}"
                                                          Data="{StaticResource IconRefresh}"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Border}"
                                                IsVisible="{Binding !IsLast}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0" Foreground="{DynamicResource TextDim}"
                               Text="A terminal gets the keys first, so Ctrl-C and the other shell keys keep working while one has focus."/>
                </StackPanel>

                <!-- Engines -->
                <StackPanel IsVisible="{Binding IsEngines}" Spacing="0">
                    <TextBlock Text="Engines" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="How Kontena discovers and selects your container engines." FontSize="13.5" Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <Border Classes="card" Padding="0" Margin="0,0,0,30">
                        <StackPanel>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-detect engines" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Watch for Docker, Podman and (later) Apple container starting or stopping." FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding AutoDetect, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="On launch" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding StartupHint}" FontSize="12" Foreground="{DynamicResource TextDim}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="210" VerticalAlignment="Center"
                                          ItemsSource="{Binding StartupOptions}"
                                          SelectedItem="{Binding SelectedStartup, Mode=TwoWay}"/>
                            </Grid>
                            <!-- Development only: hidden entirely in an ordinary release build -->
                            <Border Height="1" Background="{DynamicResource Border}" IsVisible="{Binding CanToggleDemoBackends}"/>
                            <Grid Margin="18,15" ColumnDefinitions="*,Auto" IsVisible="{Binding CanToggleDemoBackends}">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <TextBlock Text="Demo backends" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="DEV" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Show the in-memory fake engine and clusters alongside the real ones. Turn off to work against real backends only." FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Classes="pill" IsChecked="{Binding ShowDemoBackends, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="DETECTED ENGINES"/>
                    <Border Classes="card" Padding="0">
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EngineListItem">
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                        <Grid Margin="18,14" ColumnDefinitions="Auto,*,Auto">
                                            <controls:BackendChip Grid.Column="0" Chip="{Binding Chip}" ChipSize="38" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                    <Border Background="#34D39916" CornerRadius="20" Padding="7,2" VerticalAlignment="Center" IsVisible="{Binding Connected}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Connected" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="20" Padding="7,2" VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="Default" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="12" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextDim}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <!-- This list was read-only, which made it the wrong place to
                                                     be when an engine was down (KON-328): an engine started
                                                     after Kontena had nothing to click, anywhere. -->
                                                <Button Classes="ghost"
                                                        Content="{Binding RetryLabel}"
                                                        IsVisible="{Binding CanRetry}" IsEnabled="{Binding RetryEnabled}"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RetryBackendCommand}"
                                                        CommandParameter="{Binding Backend}"/>
                                                <!-- A remote also has a row further down, and that is the
                                                     one carrying Edit and Remove. This row keeps no actions
                                                     of its own — it points at where they live (KON-264). -->
                                                <Button Classes="ghost" Content="Manage below"
                                                        IsVisible="{Binding IsRemote}"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RevealRemoteCommand}"
                                                        CommandParameter="{Binding Backend}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Classes="gh" Text="KUBECONFIGS" Margin="0,30,0,12"/>
                    <Border Classes="card" Margin="0,0,0,14">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxWidth="620"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"
                                       Text="The files Kontena reads contexts from. The default one is always read. Removing an added file stops Kontena reading it — the file itself is left alone."/>
                            <ItemsControl ItemsSource="{Binding Kubeconfigs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KubeconfigSource">
                                        <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                           FontFamily="{StaticResource Mono}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="always read" FontSize="11"
                                                           IsVisible="{Binding !CanRemove}"
                                                           Foreground="{DynamicResource TextFaint}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="ghost" Padding="11,5"
                                                    IsVisible="{Binding CanRemove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveKubeconfigCommand}"
                                                    CommandParameter="{Binding}">Remove</Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="CLUSTERS" Margin="0,30,0,12" IsVisible="{Binding HasClusters}"/>
                    <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding HasClusters}">
                        <StackPanel Spacing="14">
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxWidth="620"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"
                                       Text="Every context Kontena found in your kubeconfigs. Only the ones you tick appear in the switcher — the others are not contacted at all. A kubeconfig collects clusters over time, and not all of them are yours to be one click away from."/>
                            <ItemsControl ItemsSource="{Binding Clusters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClusterChoiceRow">
                                        <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}" Margin="0,0,0,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{Binding Source}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextDim}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="NAMES IN THE SWITCHER" Margin="0,30,0,12"/>
                    <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding HasBackendNames}">
                        <StackPanel Spacing="14">
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxWidth="620"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"
                                       Text="A backend is listed under the name its source gives it, which for a kube-context is often something like gke_myproject-prod_europe-west4_cluster-1. Give it a name of your own here. Leave a field empty to go back to the original."/>
                            <ItemsControl ItemsSource="{Binding BackendNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackendNameRow">
                                        <Grid Margin="0,0,0,9" ColumnDefinitions="Auto,*">
                                            <controls:BackendChip Grid.Column="0" Chip="{Binding Chip}" ChipSize="32" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Margin="12,0,0,0"
                                                     Text="{Binding Name, Mode=TwoWay}"
                                                     PlaceholderText="{Binding SourceName}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="REMOTE ENGINES" Margin="0,30,0,12"/>
                    <Border Classes="card" Margin="0,0,0,14">
                        <StackPanel Spacing="14">
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxWidth="620"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"
                                       Text="An engine on another host appears in the switcher like a local one. Over SSH Kontena forwards the remote socket using your existing keys and agent; over TCP it needs TLS certificates."/>

                            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="seg" Classes.on="{Binding RemoteIsSsh}"
                                            Command="{Binding SetRemoteTransportCommand}" CommandParameter="ssh">
                                        <TextBlock Text="SSH" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="seg" Classes.on="{Binding RemoteIsTcp}"
                                            Command="{Binding SetRemoteTransportCommand}" CommandParameter="tcp">
                                        <TextBlock Text="TCP + TLS" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="7">
                                    <TextBlock Text="HOST" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RemoteHost, Mode=TwoWay}" PlaceholderText="build-01.example.com"
                                             FontFamily="{StaticResource Mono}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="7">
                                    <TextBlock Text="NAME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RemoteName, Mode=TwoWay}" PlaceholderText="Build server"/>
                                </StackPanel>
                            </Grid>

                            <!-- SSH -->
                            <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding RemoteIsSsh}">
                                <StackPanel Grid.Column="0" Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="USER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Text="OPTIONAL" FontSize="10" Foreground="{DynamicResource TextFaint}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding RemoteUser, Mode=TwoWay}" PlaceholderText="leave empty to use ssh_config"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="REMOTE SOCKET" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Text="OPTIONAL" FontSize="10" Foreground="{DynamicResource TextFaint}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding RemoteSocketPath, Mode=TwoWay}" PlaceholderText="/var/run/docker.sock"
                                             FontFamily="{StaticResource Mono}"/>
                                </StackPanel>
                            </Grid>

                            <!-- How to authenticate (KON-261 / KON-259). Empty is still the normal
                                 case: an agent and an ssh_config that already work keep working. -->
                            <StackPanel Spacing="9" IsVisible="{Binding RemoteIsSsh}">
                                <StackPanel Spacing="7" IsVisible="{Binding ShowKeyFile}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="KEY FILE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Text="OPTIONAL" FontSize="10" Foreground="{DynamicResource TextFaint}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding RemoteKeyFile, Mode=TwoWay}"
                                                 PlaceholderText="leave empty to use your agent and ssh_config"
                                                 FontFamily="{StaticResource Mono}"/>
                                        <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0"
                                                Click="OnBrowseKeyFile">Browse…</Button>
                                    </Grid>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding RemoteUsePassword, Mode=TwoWay}" FontSize="12.5"
                                          IsVisible="{Binding ShowPasswordOption}"
                                          Content="Use a password instead of a key"/>

                                <StackPanel Spacing="7" IsVisible="{Binding ShowPasswordBox}">
                                    <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RemotePassword, Mode=TwoWay}" PasswordChar="•"
                                             PlaceholderText="stored in your keychain, never in your settings"/>
                                    <TextBlock FontSize="12.5" TextWrapping="Wrap" MaxWidth="560"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"
                                               Text="A key is the better route where you have one — it cannot be reused elsewhere and it does not travel. This exists for hosts where you have no choice."/>
                                </StackPanel>
                            </StackPanel>

                            <!-- TCP -->
                            <StackPanel Spacing="7" IsVisible="{Binding RemoteIsTcp}">
                                <TextBlock Text="CERTIFICATE DIRECTORY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                <TextBox Text="{Binding RemoteCertificateDirectory, Mode=TwoWay}"
                                         PlaceholderText="~/.docker/certs — holding ca.pem, cert.pem and key.pem"
                                         FontFamily="{StaticResource Mono}"/>
                            </StackPanel>

                            <StackPanel Spacing="8" IsVisible="{Binding ShowInsecureWarning}">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Danger}"
                                          Data="{StaticResource IconWarning}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxWidth="560"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource TextDim}"
                                               Text="Without certificates this connection is unauthenticated and unencrypted. Anyone who can reach that port controls the host — including containers on your own network."/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding RemoteAllowInsecure, Mode=TwoWay}" FontSize="12.5"
                                          Content="Connect without TLS anyway"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,12,Auto">
                                <StackPanel Grid.Column="0" Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="PORT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Text="OPTIONAL" FontSize="10" Foreground="{DynamicResource TextFaint}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding RemotePort, Mode=TwoWay}" PlaceholderText="22 for SSH, 2376 for TLS"
                                             FontFamily="{StaticResource Mono}" MaxWidth="260" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <Button Classes="ghost" Command="{Binding CancelEditRemoteCommand}"
                                            IsVisible="{Binding IsEditingRemote}" Content="Cancel"/>
                                    <Button Classes="ghost" Command="{Binding TestRemoteCommand}"
                                            IsEnabled="{Binding !IsRemoteBusy}" Content="Test connection"/>
                                    <Button Classes="primary" Command="{Binding AddRemoteCommand}"
                                            IsEnabled="{Binding CanAddRemote}" Content="{Binding RemoteSubmitLabel}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Live, as it is typed: the submit button is disabled by this, so it has
                                 to say so rather than just go grey (KON-181). -->
                            <TextBlock Text="{Binding RemoteProblem}" FontSize="12.5" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="620"
                                       IsVisible="{Binding RemoteProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Danger}"/>
                            <TextBlock Text="{Binding RemoteError}" FontSize="12.5" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="620"
                                       IsVisible="{Binding RemoteError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Danger}"/>
                            <!-- Shown only when the test failed because nobody has trusted this host
                                 yet (KON-260). The one failure with an answer the user can give here. -->
                            <Button Classes="ghost" Command="{Binding ReviewHostKeyCommand}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding CanReviewHostKey}"
                                    IsEnabled="{Binding CanReviewHostKey}"
                                    Content="Review fingerprint…"/>
                            <TextBlock Text="{Binding RemoteNotice}" FontSize="12.5"
                                       IsVisible="{Binding RemoteNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Success}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="0" IsVisible="{Binding RemoteEngines.Count}">
                        <ItemsControl x:Name="RemoteRows" ItemsSource="{Binding RemoteEngines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RemoteEngineRow">
                                    <Grid Margin="18,14" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}"/>
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="7,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TransportLabel}" FontSize="10.5" Foreground="{DynamicResource TextDim}"/>
                                                </Border>
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="7,1"
                                                        VerticalAlignment="Center" IsVisible="{Binding IsInsecure}">
                                                    <TextBlock Text="no TLS" FontSize="10.5" Foreground="{DynamicResource Danger}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Endpoint}" FontSize="12" FontFamily="{StaticResource Mono}"
                                                           Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                            </StackPanel>
                                            <!-- The switcher skips a remote it cannot use, so this is
                                                 the only place that can say why (KON-181). -->
                                            <TextBlock Text="{Binding Problem}" FontSize="12" TextWrapping="Wrap"
                                                       MaxWidth="560" HorizontalAlignment="Left"
                                                       IsVisible="{Binding HasProblem}"
                                                       Foreground="{DynamicResource Danger}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <!-- Connecting again without going through the edit form
                                                 (KON-328). Testing a stored remote used to mean Edit →
                                                 Test → Save: a trip through a dialog to do something
                                                 that changes nothing, and only the Save re-probed. -->
                                            <Button Classes="ghost" Content="{Binding RetryLabel}"
                                                    IsVisible="{Binding CanRetry}" IsEnabled="{Binding RetryEnabled}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RetryBackendCommand}"
                                                    CommandParameter="{Binding Remote.Backend}"/>
                                            <Button Classes="ghost" Content="Edit"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditRemoteCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="ghost" Content="Remove"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveRemoteCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Registries (KON-114) -->
                <StackPanel IsVisible="{Binding IsRegistries}" Spacing="0">
                    <TextBlock Text="Registries" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Sign in to pull private images. Passwords and tokens go to your system keychain, never to a file."
                               FontSize="13.5" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <TextBlock Classes="gh" Text="SIGN IN"/>
                    <Border Classes="card" Margin="0,0,0,30">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="7">
                                    <TextBlock Text="REGISTRY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RegistryHostInput, Mode=TwoWay}" PlaceholderText="ghcr.io"
                                             FontFamily="{StaticResource Mono}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="7">
                                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox Text="{Binding RegistryUsername, Mode=TwoWay}" PlaceholderText="your-account"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="7">
                                <TextBlock Text="PASSWORD OR TOKEN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                <TextBox Text="{Binding RegistrySecret, Mode=TwoWay}" PasswordChar="•"/>
                                <TextBlock Text="For most registries a token is the right answer, not your account password."
                                           FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RegistryError}" FontSize="12.5" TextWrapping="Wrap"
                                       IsVisible="{Binding RegistryError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Danger}"/>
                            <TextBlock Text="{Binding RegistryNotice}" FontSize="12.5"
                                       IsVisible="{Binding RegistryNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource Success}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFaint}"
                                           Text="Kontena checks the login with the registry before saving it."/>
                                <Button Grid.Column="1" Classes="primary" Command="{Binding LogInCommand}"
                                        IsEnabled="{Binding CanLogIn}" Content="Sign in"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="gh" Text="SIGNED IN"/>
                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Registries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RegistryRow">
                                        <Grid Margin="18,14" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Host}" FontSize="13.5" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsInherited}" Content="Sign out"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SignOutCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="18,16" FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                                       IsVisible="{Binding !Registries.Count}"
                                       Text="No registry logins yet. Public images need none."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Updates (KON-110) -->
                <StackPanel IsVisible="{Binding IsUpdates}" Spacing="0">
                    <TextBlock Text="Updates" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Which builds Kontena offers, and when it fetches them." FontSize="13.5"
                               Foreground="{DynamicResource TextDim}" Margin="0,4,0,26"/>

                    <!-- An install that cannot replace itself says so before offering any of the rows below -->
                    <Border Classes="card" Margin="0,0,0,30" IsVisible="{Binding ShowUnsupportedNotice}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource Info}"
                                  Data="{StaticResource IconInfo}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Update.UnsupportedReason}" FontSize="12.5" TextWrapping="Wrap"
                                       LineHeight="19" Foreground="{DynamicResource TextDim}" MaxWidth="640"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding ShowUpdatePreferences}" Spacing="0">
                        <TextBlock Classes="gh" Text="CHANNEL"/>
                        <Border Classes="card" Padding="0" Margin="0,0,0,30">
                            <StackPanel>
                                <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Release channel" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="{Binding ChannelHint}" FontSize="12" TextWrapping="Wrap"
                                                   MaxWidth="470" Foreground="{DynamicResource TextDim}"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="seg" Classes.on="{Binding IsStableChannel}"
                                                    Command="{Binding SetUpdateChannelCommand}" CommandParameter="stable">
                                                <TextBlock Text="Stable" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="seg" Classes.on="{Binding IsPreviewChannel}"
                                                    Command="{Binding SetUpdateChannelCommand}" CommandParameter="preview">
                                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="seg" Classes.on="{Binding IsNightlyChannel}"
                                                    Command="{Binding SetUpdateChannelCommand}" CommandParameter="nightly">
                                                <TextBlock Text="Nightly" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Why the channel is what it is, when nobody picked it (KON-123). -->
                                <Border Background="{DynamicResource InfoSoft}" Margin="18,0,18,15" Padding="12,10"
                                        CornerRadius="{StaticResource RadiusSm}" IsVisible="{Binding IsFollowingBuildChannel}">
                                    <TextBlock Text="{Binding FollowingBuildNote}" FontSize="12.5"
                                               TextWrapping="Wrap" LineHeight="19" MaxWidth="620"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource Text}"/>
                                </Border>

                                <Border Height="1" Background="{DynamicResource Border}"/>
                                <Grid Margin="18,15" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Download updates automatically" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Fetch a new version as soon as it is found, so the update is a restart rather than a wait."
                                                   FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                                                   Foreground="{DynamicResource TextDim}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="gh" Text="THIS INSTALL"/>
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}">
                                        <Run Text="Version"/><Run Text=" "/><Run Text="{Binding Version}" FontFamily="{StaticResource Mono}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding BuildDate}" FontSize="12"
                                               IsVisible="{Binding HasBuildDate}"
                                               Foreground="{DynamicResource TextDim}"/>
                                    <TextBlock Text="{Binding Update.SidebarLabel}" FontSize="12"
                                               Foreground="{DynamicResource Primary}" IsVisible="{Binding Update.HasSidebarEntry}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Command="{Binding CheckForUpdatesCommand}"
                                        Content="Check now" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- The external tools Kontena drives (KON-109, moved here by KON-266). -->
                <views:ClusterToolingView DataContext="{Binding Tools}" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsTools}"/>

                <!-- Local clusters (KON-109 + KON-76) — its own view, so this file does not grow a sixth page. -->
                <views:LocalClustersView DataContext="{Binding LocalClusters}" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsClusters}"/>

                <!-- Rolling out onto your own machines (KON-379) — the wizard the host table,
                     credentials form and preflight were built for. -->
                <views:ProvisioningWizardView DataContext="{Binding RemoteClusters}" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsRemoteClusters}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
