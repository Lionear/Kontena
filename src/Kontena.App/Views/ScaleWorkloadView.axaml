<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="280"
             x:Class="Kontena.App.Views.ScaleWorkloadView"
             x:DataType="vm:ScaleWorkloadViewModel">

    <UserControl.Styles>
        <Style Selector="Button.stepper">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <Style Selector="Button.stepper:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
    </UserControl.Styles>

    <Border Width="460" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True" BoxShadow="0 32 80 0 #99000000">
        <StackPanel>
            <StackPanel Margin="24,22,24,20" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Scale workload" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFaint}">
                        <Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Namespace}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Spacing="9">
                    <TextBlock Text="Replicas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Height="42" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="stepper" Command="{Binding DecrementCommand}">
                                    <TextBlock Text="−" FontSize="19"/>
                                </Button>
                                <Border Width="1" Background="{DynamicResource Border}"/>
                                <TextBlock Text="{Binding Replicas}" Width="64" FontFamily="{StaticResource Mono}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="1" Background="{DynamicResource Border}"/>
                                <Button Classes="stepper" Command="{Binding IncrementCommand}">
                                    <TextBlock Text="+" FontSize="17"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFaint}">
                            <Run Text="currently "/><Run Text="{Binding CurrentReplicas}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextDim}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Border}"/>
            <Grid Margin="24,16" ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Classes="ghost" Margin="0,0,10,0" Command="{Binding CancelCommand}">Cancel</Button>
                <Button Grid.Column="2" Classes="primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}">Apply</Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
