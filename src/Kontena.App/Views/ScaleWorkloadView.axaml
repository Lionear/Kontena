<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="280"
             x:Class="Kontena.App.Views.ScaleWorkloadView"
             x:DataType="vm:ScaleWorkloadViewModel">
    <Border Width="460" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True" BoxShadow="0 32 80 0 #99000000">
        <StackPanel>
            <StackPanel Margin="24,22,24,20" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Scale workload" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFaint}">
                        <Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Namespace}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Replicas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="qa" Width="38" Height="38" Command="{Binding DecrementCommand}">
                            <TextBlock Text="−" FontSize="20" Foreground="{DynamicResource TextDim}"/>
                        </Button>
                        <Border Width="86" Height="38" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="{Binding Replicas}" FontFamily="{StaticResource Mono}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Classes="qa" Width="38" Height="38" Command="{Binding IncrementCommand}">
                            <TextBlock Text="+" FontSize="18" Foreground="{DynamicResource TextDim}"/>
                        </Button>
                        <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFaint}">
                            <Run Text="currently "/><Run Text="{Binding CurrentReplicas}" FontFamily="{StaticResource Mono}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Border}"/>
            <Grid Margin="24,16" ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Classes="ghost" Margin="0,0,10,0" Command="{Binding CancelCommand}">Cancel</Button>
                <Button Grid.Column="2" Classes="primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}">Apply</Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
