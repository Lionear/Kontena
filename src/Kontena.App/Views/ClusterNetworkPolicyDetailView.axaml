<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:views="using:Kontena.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kontena.App.Views.ClusterNetworkPolicyDetailView"
             x:DataType="vm:ClusterNetworkPolicyDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,0">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <Border CornerRadius="20" Padding="9,3" Background="{DynamicResource Surface2}" VerticalAlignment="Center"
                            ToolTip.Tip="Which directions of traffic this policy isolates">
                        <TextBlock Text="{Binding IsolatesText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="2">
                        <TextBlock Text="NAMESPACE" Classes="colhead"/>
                        <TextBlock Text="{Binding Namespace}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="POD SELECTOR" Classes="colhead"/>
                        <TextBlock Text="{Binding AppliesToText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="AGE" Classes="colhead"/>
                        <TextBlock Text="{Binding AgeText}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Classes="tab" Classes.on="{Binding IsOverviewSelected}" Command="{Binding SelectTabCommand}" CommandParameter="overview">
                        <TextBlock Text="Rules" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsPodsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="pods">
                        <TextBlock Text="{Binding PodsTabLabel}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsEventsSelected}" Command="{Binding SelectTabCommand}" CommandParameter="events">
                        <TextBlock Text="Events" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tab" Classes.on="{Binding IsYamlSelected}" Command="{Binding SelectTabCommand}" CommandParameter="yaml">
                        <TextBlock Text="YAML" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="28,20">

            <!-- Rules, one sentence per peer, rather than the nested selectors the YAML makes you
                 evaluate by hand (KON-476). -->
            <ScrollViewer IsVisible="{Binding IsOverviewSelected}">
                <StackPanel Spacing="16">

                    <TextBlock Text="Ingress — who may connect to these pods" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True" IsVisible="{Binding HasIngressRules}">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="2*,1*">
                                    <TextBlock Grid.Column="0" Text="FROM" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="PORTS" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding IngressRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NetworkPolicyRuleRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                            <Grid ColumnDefinitions="2*,1*">
                                                <TextBlock Grid.Column="0" Text="{Binding Peers}" FontSize="12.5" Foreground="{DynamicResource Text}"
                                                           TextWrapping="Wrap" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Ports}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding IngressNote}" IsVisible="{Binding IngressNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource TextFaint}" FontSize="12.5" TextWrapping="Wrap"/>

                    <TextBlock Text="Egress — where these pods may connect to" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" ClipToBounds="True" IsVisible="{Binding HasEgressRules}">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="2*,1*">
                                    <TextBlock Grid.Column="0" Text="TO" Classes="colhead"/>
                                    <TextBlock Grid.Column="1" Text="PORTS" Classes="colhead"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding EgressRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NetworkPolicyRuleRow">
                                        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                            <Grid ColumnDefinitions="2*,1*">
                                                <TextBlock Grid.Column="0" Text="{Binding Peers}" FontSize="12.5" Foreground="{DynamicResource Text}"
                                                           TextWrapping="Wrap" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Ports}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding EgressNote}" IsVisible="{Binding EgressNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource TextFaint}" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <views:RelatedPodsView IsVisible="{Binding IsPodsSelected}"/>
            <views:ObjectEventsView IsVisible="{Binding IsEventsSelected}"/>
            <views:ObjectYamlView IsVisible="{Binding IsYamlSelected}"/>
        </Panel>
    </Grid>
</UserControl>
