<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.ImagesView"
             x:DataType="vm:ImagesViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,22" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Images" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Command="{Binding ArmPruneCommand}" IsEnabled="{Binding HasUnused}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconBroom}"/>
                            <TextBlock Text="Prune unused" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Command="{Binding PullImageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconPull}"/>
                            <TextBlock Text="Pull image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding BuildImageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource PrimaryInk}" Data="{StaticResource IconBox}"/>
                            <TextBlock Text="Build image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextDim}"/>

            <!-- Prune confirmation (destructive → explicit confirm) -->
            <Border IsVisible="{Binding PruneArmed}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoftBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Stroke="{DynamicResource Warn}"
                          Data="{StaticResource IconBroom}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PruneSummary}" Margin="12,0,0,0"
                               Foreground="{DynamicResource WarnText}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="ghost" Command="{Binding CancelPruneCommand}" Margin="0,0,8,0">Cancel</Button>
                    <Button Grid.Column="3" Command="{Binding PruneCommand}"
                            Background="{DynamicResource DangerSoft}" Foreground="{DynamicResource Danger}"
                            BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="14,7" FontWeight="SemiBold">
                        Remove images
                    </Button>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasItems}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,12" ColumnDefinitions="2*,1*,1.1*,.8*,1*,90">
                            <TextBlock Grid.Column="0" Text="REPOSITORY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="TAG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="IMAGE ID" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageRowViewModel">
                                <Border Classes="row" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="{DynamicResource RowMargin}" ColumnDefinitions="2*,1*,1.1*,.8*,1*,90" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RepoName}" FontFamily="{StaticResource Mono}"
                                                       FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="{Binding RepoNamespace}" FontSize="11"
                                                       Foreground="{DynamicResource TextFaint}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Tag}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ShortId}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding UseBrush}"/>
                                            <TextBlock Text="{Binding UseText}" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa" Command="{Binding TagAndPushCommand}" ToolTip.Tip="Tag and push">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconPush}"/>
                                            </Button>
                                            <Button Classes="qa danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Two different nothings (KON-189). A search with no hits used to leave the same bare page
                 as a host with no images at all, which reads as a page that failed to load. -->
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No images match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>

            <Border IsVisible="{Binding IsEmpty}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No images on this engine yet. Pull one to get started."
                           FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
