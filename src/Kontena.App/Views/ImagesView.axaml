<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.ImagesView"
             x:DataType="vm:ImagesViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,22" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Images" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Command="{Binding ArmPruneCommand}" IsEnabled="{Binding HasUnused}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource TextDim}" Data="{StaticResource IconBroom}"/>
                            <TextBlock Text="Prune unused" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource TextDim}" Data="{StaticResource IconPull}"/>
                            <TextBlock Text="Pull image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource TextDim}"/>

            <!-- Prune confirmation (destructive → explicit confirm) -->
            <Border IsVisible="{Binding PruneArmed}" Background="#1c1810" BorderBrush="#3a3320"
                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Stroke="{StaticResource Warn}"
                          Data="{StaticResource IconBroom}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PruneSummary}" Margin="12,0,0,0"
                               Foreground="#e8cf9a" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="ghost" Command="{Binding CancelPruneCommand}" Margin="0,0,8,0">Cancel</Button>
                    <Button Grid.Column="3" Command="{Binding PruneCommand}"
                            Background="#F8717120" Foreground="{StaticResource Danger}"
                            BorderBrush="#5a2c2c" BorderThickness="1" CornerRadius="8" Padding="14,7" FontWeight="SemiBold">
                        Remove images
                    </Button>
                </Grid>
            </Border>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#141821" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,12" ColumnDefinitions="2*,1*,1.1*,.8*,1*,90">
                            <TextBlock Grid.Column="0" Text="REPOSITORY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="TAG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="IMAGE ID" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageRowViewModel">
                                <Border Classes="row" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="18,11" ColumnDefinitions="2*,1*,1.1*,.8*,1*,90" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding RepoName}" FontFamily="{StaticResource Mono}"
                                                       FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="{Binding RepoNamespace}" FontSize="11"
                                                       Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Tag}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{StaticResource Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ShortId}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding UseBrush}"/>
                                            <TextBlock Text="{Binding UseText}" FontSize="12" Foreground="{StaticResource TextDim}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
