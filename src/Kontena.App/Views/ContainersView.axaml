<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Kontena.App.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">

    <UserControl.Styles>
        <!-- A row inside a Compose group is indented by its name, not by its status dot: the dot stays
             in the column it shares with every other row, so a red one is still findable down the edge. -->
        <Style Selector="Border.row.child Button.link">
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24,22" Spacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Containers" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Command="{Binding ArmPruneCommand}" IsEnabled="{Binding HasStopped}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}"
                                  Data="{StaticResource IconBroom}"/>
                            <TextBlock Text="Prune stopped" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Command="{Binding PullImageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}"
                                  Data="{StaticResource IconPull}"/>
                            <TextBlock Text="Pull image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding RunContainerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource PrimaryInk}"
                                  Data="{StaticResource IconPlay}"/>
                            <TextBlock Text="Run container" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border IsVisible="{Binding PruneArmed}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoftBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Stroke="{DynamicResource Warn}"
                          Data="{StaticResource IconBroom}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PruneSummary}" Margin="12,0,0,0"
                               Foreground="{DynamicResource WarnText}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="ghost" Command="{Binding CancelPruneCommand}" Margin="0,0,8,0">Cancel</Button>
                    <Button Grid.Column="3" Command="{Binding PruneCommand}"
                            Background="{DynamicResource DangerSoft}" Foreground="{DynamicResource Danger}"
                            BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontWeight="SemiBold">
                        Remove containers
                    </Button>
                </Grid>
            </Border>

            <!-- Loading state -->
            <StackPanel Margin="0,90,0,0" Spacing="16" HorizontalAlignment="Center"
                        IsVisible="{Binding !HasLoaded}">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                             Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface2}"/>
                <TextBlock Text="Loading containers…" Foreground="{DynamicResource TextDim}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding IsEmpty}" Margin="0,54,0,0" Spacing="18" HorizontalAlignment="Center" MaxWidth="520">
                <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                    <Path Classes="icon" Width="34" Height="34" Stroke="{DynamicResource TextFaint}" Data="{StaticResource IconContainer}"/>
                </Border>
                <TextBlock Text="No containers running yet" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                <TextBlock Text="Your engine is connected and idle. Launch your first container, or pull an image to get going — Kontena handles the rest."
                           FontSize="13" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Classes="ghost" Command="{Binding PullImageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconPull}"/>
                            <TextBlock Text="Pull image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding RunContainerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource PrimaryInk}" Data="{StaticResource IconPlay}"/>
                            <TextBlock Text="Run container" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Spacing="11" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Quick start from a template" FontSize="12" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Classes="ghost" Command="{Binding RunTemplateCommand}" CommandParameter="nginx">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#5AB8FF" VerticalAlignment="Center"/>
                                <TextBlock Text="nginx" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding RunTemplateCommand}" CommandParameter="postgres:16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#34D399" VerticalAlignment="Center"/>
                                <TextBlock Text="postgres:16" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding RunTemplateCommand}" CommandParameter="redis:7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#F87171" VerticalAlignment="Center"/>
                                <TextBlock Text="redis:7" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding RunTemplateCommand}" CommandParameter="node:22">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#F5B14C" VerticalAlignment="Center"/>
                                <TextBlock Text="node:22" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Stat cards -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14" IsVisible="{Binding HasAnyContainers}">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="Running" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RunningCount}" FontSize="26" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Danger}" VerticalAlignment="Center"/>
                            <TextBlock Text="Stopped" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StoppedCount}" FontSize="26" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Info}" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CpuTotalText}" FontSize="26" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Memory" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MemTotalText}" FontSize="26" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Container table -->
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasAnyContainers}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,12" ColumnDefinitions="24,1.6*,1.7*,1*,90,90,158">
                            <TextBlock Grid.Column="1" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="IMAGE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="PORTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="MEM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" TextAlignment="Right"/>

                            <!-- Grouping lives in the header of the thing it groups, and is remembered
                                 per backend: someone working container-by-container does not want the
                                 extra rows in the way (KON-159). -->
                            <Button Grid.Column="6" Classes="qa" Command="{Binding ToggleGroupingCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Classes.on="{Binding IsGrouped}"
                                    ToolTip.Tip="Group containers by Compose project">
                                <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconLayers}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.DataTemplates>

                            <!-- ── A Compose project heading ────────────────────────────────────────
                                 Same column widths as a container row, so the columns line up across
                                 both. It fills three of them: name, how much of the stack is up, and
                                 the project actions. No image, ports or numbers — a sum of four
                                 containers' CPU is a lie, and four images have nothing to show. -->
                            <DataTemplate DataType="vm:ComposeGroupRowViewModel" x:DataType="vm:ComposeGroupRowViewModel">
                                <Border Classes="row" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="{DynamicResource RowMargin}" ColumnDefinitions="24,1.6*,1.7*,1*,90,90,158" VerticalAlignment="Center">
                                        <!-- Sized to the 24px status column rather than the default 30, so it
                                             cannot lean into the name beside it. -->
                                        <Button Grid.Column="0" Classes="qa" Command="{Binding ToggleCommand}"
                                                Width="22" Height="22" Margin="-2,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsVisible="{Binding !IsOpen}"
                                                ToolTip.Tip="Show this project's containers">
                                            <Path Classes="icon" Width="13" Height="13"
                                                  Data="{StaticResource IconChevronRight}"/>
                                        </Button>
                                        <Button Grid.Column="0" Classes="qa" Command="{Binding ToggleCommand}"
                                                Width="22" Height="22" Margin="-2,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsVisible="{Binding IsOpen}"
                                                ToolTip.Tip="Hide this project's containers">
                                            <Path Classes="icon" Width="13" Height="13"
                                                  Data="{StaticResource IconChevronDown}"/>
                                        </Button>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="20" Padding="7,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Compose" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SummaryText}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Classes="link" Command="{Binding OpenProjectCommand}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Open this project on the Projects page, where it is operated as a whole">
                                            <TextBlock Text="Open in Projects" FontSize="12"
                                                       Foreground="{DynamicResource TextFaint}"/>
                                        </Button>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa" Command="{Binding RestartCommand}" IsVisible="{Binding CanStop}" ToolTip.Tip="Restart project">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconRestart}"/>
                                            </Button>
                                            <Button Classes="qa" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" ToolTip.Tip="Start project">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconPlay}"/>
                                            </Button>
                                            <Button Classes="qa" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" ToolTip.Tip="Stop project">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconStop}"/>
                                            </Button>
                                            <Button Classes="qa danger" Command="{Binding DownCommand}" ToolTip.Tip="Take down — remove this project's containers and networks">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ContainerRowViewModel" x:DataType="vm:ContainerRowViewModel">
                                <Border Classes="row" Classes.child="{Binding IsChild}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid Margin="{DynamicResource RowMargin}" ColumnDefinitions="24,1.6*,1.7*,1*,90,90,158" VerticalAlignment="Center">
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding StatusBrush}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="link" Command="{Binding OpenCommand}"
                                                ToolTip.Tip="Open details" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <!-- Trimmed: indenting a child eats into the column, and a
                                                     compose name is the project plus the service plus an
                                                     ordinal — long by construction. -->
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}"
                                                           FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <!-- Inside a stack, the service is what people call it — "web", not
                                                         "azuriom-web-1". Only shown where it means something. -->
                                                    <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="4" Padding="6,1"
                                                            VerticalAlignment="Center" IsVisible="{Binding IsChild}">
                                                        <TextBlock Text="{Binding Service}" FontFamily="{StaticResource Mono}"
                                                                   FontSize="10" Foreground="{DynamicResource TextFaint}"/>
                                                    </Border>
                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource DockerChip}">
                                                        <TextBlock Text="{Binding BackendChip}" FontFamily="{StaticResource Mono}"
                                                                   FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Info}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="20" Padding="7,1"
                                                            VerticalAlignment="Center" IsVisible="{Binding IsManaged}"
                                                            ToolTip.Tip="Carries a kontena.managed label — excluded from Kontena's prune">
                                                        <TextBlock Text="{Binding ManagedByText}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Primary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="2" Text="{Binding Image}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PortsText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CpuText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding MemText}" FontFamily="{StaticResource Mono}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="qa" Command="{Binding RestartCommand}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Restart">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconRestart}"/>
                                            </Button>
                                            <Button Classes="qa" Command="{Binding StartCommand}" IsVisible="{Binding IsNotRunning}" ToolTip.Tip="Start">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconPlay}"/>
                                            </Button>
                                            <Button Classes="qa" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Stop">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconStop}"/>
                                            </Button>
                                            <Button Classes="qa danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource Danger}" Data="{StaticResource IconTrash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- No search matches (inside the table, below the header) -->
                    <TextBlock IsVisible="{Binding HasNoMatches}" Text="No containers match your search."
                               Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Margin="0,26"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
