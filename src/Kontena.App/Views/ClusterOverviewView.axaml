<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kontena.App.Views"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterOverviewView"
             x:DataType="vm:ClusterOverviewViewModel">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClusterName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Distribution}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    </Border>
                    <TextBlock Text="{Binding Version}" FontSize="12.5" FontFamily="{StaticResource Mono}"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                    <!-- This release is one its publisher has dropped (KON-371). Same icon as the node
                         rows below, deliberately: both say "this version needs looking at". What is
                         wrong differs, and that is what the two tooltips are for. -->
                    <Path Classes="icon" Width="13" Height="13" VerticalAlignment="Center"
                          IsVisible="{Binding HasSupportWarning}" Stroke="{DynamicResource Warn}"
                          Data="{StaticResource IconWarning}" ToolTip.Tip="{Binding SupportDetail}"/>
                </StackPanel>
                <TextBlock Text="Cluster overview" FontSize="13" Foreground="{DynamicResource TextDim}"/>
            </StackPanel>

            <!-- Until the six reads land, every count below is zero and the node table is empty, which
                 is what a cluster with nothing on it looks like too (KON-375). -->
            <Border Height="2" Margin="0,-12,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2"/></Border>

            <!-- Never silent about not being live (KON-250, KON-340). This page summarises five kinds
                 in five numbers, and a stale number looks exactly like a current one — there is no
                 empty table here to hint that something stopped. -->
            <Border IsVisible="{Binding LiveNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,11">
                <TextBlock Text="{Binding LiveNotice}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </Border>

            <!-- Stat cards. Seven of them since KON-378, laid out four across and wrapping rather than
                 stretched over one row: seven columns leave a tile about 83px of content at the
                 window's default 1180px, and "65.1 GB" at 26px is about 94px — so a fleet's memory
                 would be clipped at the size the app usually opens in, never mind the 900px minimum.
                 Four gives a tile roughly 177px there and still ~104px at the minimum, which is the
                 widest string this row has to hold, so the values keep their 26px.
                 The repeated per-tile attributes live in the styles below — seven copies of the same
                 four setters is where they stop agreeing. -->
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Grid.Styles>
                    <Style Selector="Border.stat">
                        <Setter Property="Background" Value="{DynamicResource Surface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
                        <Setter Property="Padding" Value="16,14"/>
                    </Style>
                    <!-- Trimmed rather than cut: a tile still gets tight towards the window's 900px
                         minimum, and a hard clip turns "51.5 GB" into "51.5 G" — a number that is not
                         wrong-looking, just wrong. An ellipsis says the tile ran out of room. -->
                    <Style Selector="Border.stat TextBlock.label">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style Selector="Border.stat TextBlock.value">
                        <Setter Property="FontSize" Value="26"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <!-- So a trimmed tile still has its number somewhere. -->
                        <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}"/>
                    </Style>
                </Grid.Styles>
                <Border Grid.Row="0" Grid.Column="0" Classes="stat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Nodes"/>
                        <TextBlock Classes="value" Text="{Binding NodeCount}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Classes="stat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Namespaces"/>
                        <TextBlock Classes="value" Text="{Binding NamespaceCount}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Classes="stat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Workloads"/>
                        <TextBlock Classes="value" Text="{Binding WorkloadCount}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Classes="stat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Pods"/>
                        <TextBlock Classes="value" Text="{Binding PodCount}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Classes="stat">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Services"/>
                        <TextBlock Classes="value" Text="{Binding ServiceCount}"/>
                    </StackPanel>
                </Border>
                <!-- The ceiling the cluster has, not what it is using — the charts below answer that
                     (KON-378). They flow on with the counts rather than claiming a row of their own:
                     "Max" says which kind of number this is, and a row held open for two tiles is two
                     empty slots. Ready nodes only; the tooltip says so, since a node going NotReady
                     drops the total and there is nothing else on the page to explain the change. -->
                <Border Grid.Row="1" Grid.Column="1" Classes="stat"
                        ToolTip.Tip="Allocatable CPU across the Ready nodes">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Max CPUs"/>
                        <TextBlock Classes="value" Text="{Binding MaxCpu}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Classes="stat"
                        ToolTip.Tip="Allocatable memory across the Ready nodes">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Max Memory"/>
                        <TextBlock Classes="value" Text="{Binding MaxMemory}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Cluster usage over time (KON-347). Above the node table because "is it busy" comes
                 before "which node", and summed over pods so it agrees with the namespace and
                 workload charts rather than being a fourth number to reconcile. -->
            <StackPanel IsVisible="{Binding ShowUsageGraphs}" Spacing="12">
                <TextBlock Text="Usage" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <views:UsagePanel DataContext="{Binding Usage}"/>
            </StackPanel>

            <!-- Nodes table -->
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="1.8*,1.2*,1*,1.2*,1.2*,1.6*">
                            <TextBlock Grid.Column="0" Text="NODE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="ROLES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="2" Text="STATUS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="3" Text="VERSION" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Grid.Column="4" Text="CPU" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                            <!-- Widest column: "6.44 GB / 17.2 GB" is a longer string than anything
                                 else on this row (KON-378). -->
                            <TextBlock Grid.Column="5" Text="MEMORY" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NodeRow">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                    <Grid ColumnDefinitions="1.8*,1.2*,1*,1.2*,1.2*,1.6*">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Roles}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextDim}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            <!-- Kubelet outside the supported skew window; the detail is in the tooltip (KON-95) -->
                                            <Path Classes="icon" Width="12" Height="12" VerticalAlignment="Center"
                                                  IsVisible="{Binding HasVersionWarning}" Stroke="{DynamicResource Warn}"
                                                  Data="{StaticResource IconWarning}" ToolTip.Tip="{Binding VersionWarningDetail}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding Cpu}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Memory}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
