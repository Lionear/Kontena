<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:Kontena.App.Behaviors"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
             x:Class="Kontena.App.Views.ComposeLogsView"
             x:DataType="vm:ComposeLogsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
        </Style>
    </UserControl.Styles>

    <Border Width="860" Height="620" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True" BoxShadow="0 32 80 0 #99000000">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="24,20">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource PrimarySoft}">
                    <Path Classes="icon" Width="19" Height="19" Stroke="{DynamicResource Primary}" Data="{StaticResource IconLogs}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Project, StringFormat='{}{0} · aggregated logs'}"
                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Combined, colour-per-service log stream for the whole project."
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="qa" Width="32" Height="32" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
                    <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconClose}"/>
                </Button>
            </Grid>
            <Border Grid.Row="0" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Bottom"/>

            <!-- Toolbar: legend + filter + follow/clear -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,12">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Legend}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComposeServiceLegend">
                            <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="9,3" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Service}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{DynamicResource TextDim}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Classes="search" Width="200" Text="{Binding Filter, Mode=TwoWay}" PlaceholderText="Filter…"/>
                    <Button Classes="pill" Classes.on="{Binding AutoScroll}" Command="{Binding ToggleFollowCommand}"
                            ToolTip.Tip="Follow tail">Follow</Button>
                    <Button Classes="qa" Width="32" Height="32" Command="{Binding ClearCommand}" ToolTip.Tip="Clear">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{DynamicResource TextDim}" Data="{StaticResource IconTrash}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Log stream -->
            <Border Grid.Row="2" Background="{DynamicResource Console}">
                <ListBox x:Name="LogList" behaviors:AutoScroll.Enabled="True" behaviors:AutoScroll.Follow="{Binding AutoScroll, Mode=TwoWay}" ItemsSource="{Binding Lines}" Background="Transparent" Padding="16,12"
                         SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComposeLogLine">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Text="{Binding Service}" FontFamily="{StaticResource Mono}" FontSize="12"
                                           LineHeight="19" Foreground="{Binding ServiceBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12"
                                           LineHeight="19" Foreground="{DynamicResource TextDim}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</UserControl>
