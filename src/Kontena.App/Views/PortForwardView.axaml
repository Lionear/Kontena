<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="300"
             x:Class="Kontena.App.Views.PortForwardView"
             x:DataType="vm:PortForwardViewModel">
    <Border Width="480" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True" BoxShadow="0 32 80 0 #99000000">
        <StackPanel>
            <StackPanel Margin="24,22,24,20" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Port forward" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="{Binding TargetLabel}" FontSize="12.5" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding !IsActive}">
                    <StackPanel Grid.Column="0" Spacing="7">
                        <TextBlock Text="Remote port" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        <ComboBox IsVisible="{Binding HasPresetPorts}" ItemsSource="{Binding Ports}" SelectedItem="{Binding RemotePort, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        <NumericUpDown IsVisible="{Binding !HasPresetPorts}" Value="{Binding RemotePort, Mode=TwoWay}" Minimum="1" Maximum="65535" FormatString="0" Increment="1"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Bottom" Margin="14,0,14,6"/>
                    <StackPanel Grid.Column="2" Spacing="7">
                        <TextBlock Text="Local port" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                        <NumericUpDown Value="{Binding LocalPort, Mode=TwoWay}" Minimum="1" Maximum="65535" FormatString="0" Increment="1"/>
                    </StackPanel>
                </Grid>

                <!-- Active tunnel. It belongs to the app now, not to this window: closing here leaves it
                     running, and the Port forwards page is where it is listed and stopped. -->
                <StackPanel IsVisible="{Binding IsActive}" Spacing="8">
                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="10" Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ForwardText}" FontFamily="{StaticResource Mono}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Stays open after you close this window — find it under Port forwards."
                               FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Border}"/>
            <Grid Margin="24,16" ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Classes="ghost" Margin="0,0,10,0" Command="{Binding CloseCommand}"
                        Content="{Binding CloseLabel}" IsVisible="{Binding !IsActive}"/>
                <Button Grid.Column="2" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" IsVisible="{Binding !IsActive}">Start</Button>
                <Button Grid.Column="2" Classes="primary" Command="{Binding CloseCommand}" IsVisible="{Binding IsActive}">Done</Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
