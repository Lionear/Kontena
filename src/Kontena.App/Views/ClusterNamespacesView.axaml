<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kontena.App.ViewModels"
             xmlns:controls="using:Kontena.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Kontena.App.Views.ClusterNamespacesView"
             x:DataType="vm:ClusterNamespacesViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <TextBlock Text="Namespaces" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <Border Height="2" Margin="0,-8,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2"/></Border>
            <!-- Never silent about not being live: a list that has quietly stopped moving looks
                 exactly like a cluster where nothing is happening, and those want opposite
                 reactions (KON-250). -->
            <Border IsVisible="{Binding LiveNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,11">
                <TextBlock Text="{Binding LiveNotice}" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True"
                    IsVisible="{Binding HasItems}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid ColumnDefinitions="2*,1*,0.8*">
                            <controls:SortableHeader Grid.Column="0" Text="NAME" Key="NAME" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="1" Text="STATUS" Key="STATUS" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                            <controls:SortableHeader Grid.Column="2" Text="AGE" Key="AGE" SortColumn="{Binding SortColumn}" SortDescending="{Binding SortDescending}" SortCommand="{Binding SortByCommand}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NamespaceRow">
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="{DynamicResource RowPadding}">
                                    <Grid ColumnDefinitions="2*,1*,0.8*">
                                        <Button Grid.Column="0" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextDim}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Age}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Typing something with no hits leaves an empty page, which reads as a page that failed
                 to load rather than a search that found nothing (KON-164). -->
            <Border IsVisible="{Binding HasNoMatches}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16">
                <TextBlock Text="No namespaces match that search." FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
