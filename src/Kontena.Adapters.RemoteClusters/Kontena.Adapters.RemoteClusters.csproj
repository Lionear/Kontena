<Project Sdk="Microsoft.NET.Sdk">

  <!-- The provisioners that install onto machines someone already owns (kubeadm, k0s, Talos). Its own
       project rather than a third of Kontena.Adapters.LocalClusters: that name would stop being true,
       and the two sides share no code — the remote spec, its credentials and its transport were all
       built alongside the local ones rather than on top of them (KON-232). -->

  <ItemGroup>
    <ProjectReference Include="..\Kontena.Sdk\Kontena.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kontena.Adapters.RemoteClusters.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
