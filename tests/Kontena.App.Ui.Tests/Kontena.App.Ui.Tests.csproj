<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate from Kontena.App.Tests on purpose (KON-198). These tests need a running Avalonia
    application, and starting one gives the process a dispatcher with a thread that owns every
    AvaloniaObject in it. The view-model tests next door touch those objects from xUnit's own
    threads, which is fine with no application running and a thread-affinity failure with one — so
    the two cannot share a process.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.0.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kontena.App\Kontena.App.csproj" />
  </ItemGroup>

</Project>
