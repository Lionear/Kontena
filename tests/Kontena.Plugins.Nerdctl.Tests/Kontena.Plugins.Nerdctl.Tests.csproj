<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kontena.Plugins.Nerdctl\Kontena.Plugins.Nerdctl.csproj" />
    <!-- The host's plugin loader, so NerdctlPackagingTests can prove the packaged layout actually
         loads (KON-141 PR 5) rather than only that its parts look right. Test-only, and this
         direction on purpose: the plugin's tests may know about the host, the host must not know
         about the plugin. ExtensionBoundaryTests keeps src/Kontena.Plugins.* on Kontena.Sdk alone. -->
    <ProjectReference Include="..\..\src\Kontena.Engines\Kontena.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
